<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test helper: the real DownloadManager + NativeBridge (no WPF) served on the real named pipe, so the real MakanNativeHost and the real extension code can talk to it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <RestoreSources Condition="Exists('/tmp/nofeed')">/tmp/nofeed</RestoreSources>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\EngineTests\MemoryStore.cs" />
    <Compile Include="..\..\MakanDownloadManager\Models\*.cs" />
    <Compile Include="..\..\MakanDownloadManager\Services\Torrent\*.cs" />
    <Compile Include="..\..\MakanDownloadManager\Services\*.cs"
             Exclude="..\..\MakanDownloadManager\Services\DownloadDb.cs;..\..\MakanDownloadManager\Services\HistoryService.cs;..\..\MakanDownloadManager\Services\DbQueueStore.cs;..\..\MakanDownloadManager\Services\DesktopServices.cs" />
  </ItemGroup>
</Project>
