{
  "manifest_version": 3,
  "name": "Epsilon Download Manager",
  "version": "1.7.0",
  "description": "Epsilon Download Manager browser integration with smart capture, media detection, queues and a download basket.",
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "cookies",
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "i18n.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Epsilon Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "epsilon-download-manager@makanlab.tech",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true
    }
  ],
  "commands": {
    "download-all-links": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Send all page links to Epsilon"
    }
  }
}
