<Window x:Class="MakanDownloadManager.SettingsWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="800" Height="760" MinWidth="720" MinHeight="600" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Click="Ok_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="100"/>
      <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" MinWidth="100"/>
    </StackPanel>

    <TabControl x:Name="MainTabs">
      <!-- General -->
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,14">
            <TextBlock Text="Browser integration" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,8">
              <StackPanel>
                <StackPanel x:Name="BrowserStatusPanel"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Set up / repair…" Click="Repair_Click"/>
                  <Button Content="Check again" Click="Recheck_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <CheckBox x:Name="LaunchStartup" Content="Start Makan (in the tray) when Windows starts" Margin="0,16,0,6"/>
            <CheckBox x:Name="ClipboardWatch" Content="Offer to download links that I copy to the clipboard" Margin="0,0,0,16"/>

            <TextBlock Text="Take over downloads from these browsers" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,8">
              <StackPanel>
                <CheckBox x:Name="BrChrome" Content="Google Chrome, Brave and other Chromium browsers" Margin="0,2"/>
                <CheckBox x:Name="BrEdge" Content="Microsoft Edge" Margin="0,2"/>
                <CheckBox x:Name="BrFirefox" Content="Mozilla Firefox" Margin="0,2"/>
                <CheckBox x:Name="BrOpera" Content="Opera" Margin="0,2"/>
                <CheckBox x:Name="BrVivaldi" Content="Vivaldi" Margin="0,2"/>
                <CheckBox x:Name="BrOther" Content="Other browsers" Margin="0,2"/>
                <TextBlock Text="Hold Alt while clicking a download link to let the browser download it instead of Makan." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left">
              <ComboBoxItem Content="English"/>
              <ComboBoxItem Content="فارسی (Persian)"/>
            </ComboBox>
            <TextBlock Text="The language changes when Makan is restarted." Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>

            <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left">
              <ComboBoxItem Content="Light"/>
              <ComboBoxItem Content="Orange"/>
              <ComboBoxItem Content="Makan (blue grey)"/>
              <ComboBoxItem Content="Obsidian (black)"/>
              <ComboBoxItem Content="Nebula (dark violet)"/>
              <ComboBoxItem Content="Lilac (dark lilac)"/>
              <ComboBoxItem Content="Dracula (dark red)"/>
              <ComboBoxItem Content="Uhnohh (dark yellow)"/>
              <ComboBoxItem Content="Follow Windows"/>
            </ComboBox>
            <TextBlock Text="The theme changes as soon as you press OK." Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- File types -->
      <TabItem Header="File types">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,14">
            <TextBlock Text="Take over downloads of these file types (separate with spaces; R0* matches .r00, .r01 …). Leave empty to take over every type." TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBox x:Name="FileTypesBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            <Button Content="Default" Click="DefaultFileTypes_Click" HorizontalAlignment="Right"/>

            <TextBlock Text="Leave downloads from these sites to the browser (separate with spaces, * means anything)" TextWrapping="Wrap" Margin="0,12,0,6"/>
            <TextBox x:Name="SitesBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            <Button Content="Default" Click="DefaultSites_Click" HorizontalAlignment="Right"/>

            <TextBlock Text="Leave downloads from these addresses to the browser (one per line, * means anything)" TextWrapping="Wrap" Margin="0,12,0,6"/>
            <TextBox x:Name="AddressesBox" Height="120" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Save to -->
      <TabItem Header="Save to">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,14">
            <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="DeleteCategoryButton" Content="Delete" Click="DeleteCategory_Click"/>
              <Button DockPanel.Dock="Right" Content="New…" Click="NewCategory_Click"/>
              <ComboBox x:Name="CategoryCombo" SelectionChanged="CategoryCombo_SelectionChanged"/>
            </DockPanel>
            <TextBlock Text="File types in this category (separate with spaces)" Margin="0,12,0,6"/>
            <TextBox x:Name="CategoryTypesBox" Height="76" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            <TextBlock Text="Folder for this category" Margin="0,12,0,6"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseCategory_Click"/><TextBox x:Name="CategoryFolderBox"/></DockPanel>
            <CheckBox x:Name="ChangeFolderLast" Content="Change the folder of a category to the one I chose last" Margin="0,10,0,0"/>

            <Separator Margin="0,16"/>
            <TextBlock Text="Main download folder (used for 'General' and as the base of the other categories)" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseBase_Click"/><TextBox x:Name="BaseFolderBox"/></DockPanel>
            <CheckBox x:Name="SetFileDate" Content="Give finished files the date reported by the server" Margin="0,12,0,0"/>

            <Separator Margin="0,16"/>
            <TextBlock Text="Temporary folder (parts of unfinished downloads)" Margin="0,0,0,6"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseTemp_Click"/><TextBox x:Name="TempFolderBox"/></DockPanel>
            <TextBlock Text="Empty = next to the final file. A folder on another physical drive makes assembling big files faster. Applies to new downloads." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <Separator Margin="0,16"/>
            <TextBlock Text="Torrents" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseTorrent_Click"/><TextBox x:Name="TorrentFolderBox"/></DockPanel>
            <TextBlock Text="Empty = torrents save to the main download folder above, same as everything else. A separate folder here applies to new torrents only (magnet links, .torrent files, from the browser or the phone remote page); torrents already added keep their current folder." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Downloads -->
      <TabItem Header="Downloads">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,14">
            <CheckBox x:Name="AskBefore" Content="Show the 'Download File Info' window before a download starts" Checked="AskBefore_Changed" Unchecked="AskBefore_Changed"/>
            <CheckBox x:Name="OnlyQueue" Content="Do not start downloading, only add files to the queue" Margin="26,6,0,0"/>
            <CheckBox x:Name="ShowProgress" Content="Show the download progress window when a download starts" Margin="0,10,0,0"/>
            <CheckBox x:Name="ShowWindowOnCapture" Content="Bring Makan's window to the front when a new download arrives (from the browser, a magnet link, etc.)" Margin="0,10,0,0"/>
            <CheckBox x:Name="ShowComplete" Content="Show a 'download complete' window" Margin="0,10,0,0"/>
            <TextBlock Text="The 'download complete' window is not shown for files started by a queue." Foreground="{DynamicResource Muted}" Margin="26,4,0,0"/>

            <Separator Margin="0,16"/>
            <CheckBox x:Name="AskQueueLater" Content="Show the queue chooser when I press Download Later"/>
            <CheckBox x:Name="AskQueueBatch" Content="Show the queue chooser in the Download All Links window" Margin="0,8,0,0"/>
            <CheckBox x:Name="IgnoreModified" Content="Ignore file modification time changes when resuming a download" Margin="0,8,0,0"/>

            <TextBlock Text="If a download link is added twice:" Margin="0,16,0,6"/>
            <ComboBox x:Name="DuplicateBox">
              <ComboBoxItem Content="Show a window and ask what to do"/>
              <ComboBoxItem Content="Add it again with a numeric suffix"/>
              <ComboBoxItem Content="Overwrite the existing file"/>
              <ComboBoxItem Content="Skip it (keep the existing download)"/>
            </ComboBox>

            <TextBlock Text="User-Agent for downloads I add by hand" Margin="0,16,0,6"/>
            <TextBox x:Name="UserAgentBox"/>

            <Separator Margin="0,16"/>
            <CheckBox x:Name="AvOn" Content="Scan finished downloads with an antivirus program"/>
            <TextBlock Text="Program" Margin="26,10,0,4"/>
            <DockPanel Margin="26,0,0,0"><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseAv_Click"/><TextBox x:Name="AvProgramBox"/></DockPanel>
            <TextBlock Text="Arguments (%1 stands for the downloaded file)" Margin="26,10,0,4"/>
            <DockPanel Margin="26,0,0,0"><Button DockPanel.Dock="Right" Content="Default" Click="DefaultAv_Click"/><TextBox x:Name="AvArgsBox"/></DockPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- YouTube and other sites (yt-dlp) -->
      <TabItem Header="YouTube &amp; other sites">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,14">
            <TextBlock TextWrapping="Wrap" Text="YouTube and many other video sites protect their videos. Makan reads them with the free program yt-dlp, runs the sites' player code with Deno, and joins video and sound with FFmpeg."/>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="yt-dlp" FontWeight="SemiBold" Margin="0,3"/><TextBlock x:Name="YtStatus" Grid.Column="1" TextWrapping="Wrap" Margin="0,3"/>
                <TextBlock Text="Deno" FontWeight="SemiBold" Grid.Row="1" Margin="0,3"/><TextBlock x:Name="DenoStatus" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,3"/>
                <TextBlock Text="FFmpeg" FontWeight="SemiBold" Grid.Row="2" Margin="0,3"/><TextBlock x:Name="FfmpegStatus" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,3"/>
              </Grid>
            </Border>
            <CheckBox x:Name="InstallFfmpeg" Content="Also download FFmpeg (large, needed for videos above 360p and for MP3)" Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="InstallButton" Content="Download / update tools" Click="InstallTools_Click" Style="{StaticResource PrimaryButton}" Margin="0"/>
              <TextBlock x:Name="InstallStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ProgressBar x:Name="InstallBar" IsIndeterminate="True" Height="5" Margin="0,8,0,0" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0"/>
            <TextBlock Text="The tools are stored in Makan's own folder. yt-dlp keeps itself up to date, because YouTube changes often." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Separator Margin="0,16"/>
            <TextBlock Text="Path of yt-dlp (leave empty to use Makan's copy)" Margin="0,0,0,4"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseYt_Click"/><TextBox x:Name="YtPathBox" TextChanged="YtPath_Changed"/></DockPanel>
            <TextBlock Text="Use the login of my browser (for private or age-restricted videos)" Margin="0,14,0,4"/>
            <ComboBox x:Name="CookiesBox" Width="220" HorizontalAlignment="Left">
              <ComboBoxItem Content="None"/>
              <ComboBoxItem Content="Chrome"/>
              <ComboBoxItem Content="Edge"/>
              <ComboBoxItem Content="Firefox"/>
              <ComboBoxItem Content="Brave"/>
            </ComboBox>
            <TextBlock Text="Only download videos you have the right to save. Some sites forbid downloading in their terms of use." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Connection -->
      <TabItem Header="Connection">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,14">
            <TextBlock Text="Maximum simultaneous downloads (files that are not started by a queue)"/>
            <Slider x:Name="Slots" Minimum="1" Maximum="16" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ElementName=Slots, Path=Value, StringFormat={}{0:0}}" FontWeight="SemiBold"/>

            <TextBlock Text="Global speed limit (KB/s, 0 = unlimited)" Margin="0,16,0,6"/>
            <TextBox x:Name="Speed" Text="0" Width="160" HorizontalAlignment="Left"/>

            <TextBlock Text="Apply this limit" Margin="0,10,0,6"/>
            <ComboBox x:Name="SpeedScope" Width="300" HorizontalAlignment="Left">
              <ComboBoxItem Content="Across all downloads combined"/>
              <ComboBoxItem Content="Separately to each download"/>
            </ComboBox>

            <TextBlock Text="Default connections per download" Margin="0,16,0,0"/>
            <Slider x:Name="Connections" Minimum="1" Maximum="16" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ElementName=Connections, Path=Value, StringFormat={}{0:0}}" FontWeight="SemiBold"/>

            <CheckBox x:Name="AutoResume" Content="Resume unfinished downloads by themselves when Makan starts" Margin="0,18,0,0"/>
            <CheckBox x:Name="KeepAwake" Content="Keep the computer awake while files are downloading" Margin="0,10,0,0"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="26,4,0,0"
                       Text="Prevents automatic sleep while a transfer is active. The display may still turn off normally."/>
            <CheckBox x:Name="SmartConnections" Content="Smart connections: use fewer connections for servers that throttle me" Margin="0,10,0,0"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="26,4,0,0"
                       Text="Makan always starts with the number above. Only a server that answers 'too many requests' gets fewer connections next time (see the Intelligent Center)."/>

            <TextBlock Text="FFmpeg (optional)" Margin="0,18,0,6"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFfmpeg_Click"/><TextBox x:Name="Ffmpeg"/></DockPanel>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Videos are always saved as .ts without it. FFmpeg is only needed to convert them to .mp4 or to merge a separate audio track. Leave empty to search PATH / the Makan folder."/>

            <TextBlock Text="Speed boost" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <CheckBox x:Name="BoostSpeed" Content="Pause Windows Update and similar background traffic while a download is running" Margin="0,8,0,0"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="26,4,0,0"
                       Text="Off by default. Needs administrator rights, which Makan does not request on its own - without them this does nothing and says so, rather than failing silently. It only pauses a short list of Windows services (Windows Update, BITS, Delivery Optimization); it cannot stop other programs that are already mid-transfer, and everything paused resumes as soon as nothing is downloading, or Makan closes."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="BitTorrent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,14">
            <TextBlock Text="Connection" FontWeight="SemiBold"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8"
                       Text="Changing the port, DHT or peer exchange needs Makan to restart before it takes effect."/>
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="Random port" Click="RandomTorrentPort_Click" Margin="8,0,0,0"/>
              <TextBlock Text="Port used for incoming connections:" VerticalAlignment="Center"/>
              <TextBox x:Name="TorrentPortBox" Width="80" Margin="8,0,0,0" HorizontalAlignment="Left" DockPanel.Dock="Left"/>
            </DockPanel>
            <CheckBox x:Name="TorrentDht" Content="Enable DHT (find peers for a magnet link even without a working tracker)" Margin="0,4,0,0"/>
            <CheckBox x:Name="TorrentPex" Content="Enable peer exchange (learn about more peers from the ones already connected)" Margin="0,8,0,0"/>

            <TextBlock Text="Bandwidth" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="No automatic torrent speed cap is applied. Only limits you enter here or in Torrent details can limit torrent speed."/>
            <TextBlock Text="Global torrent download limit (KB/s, 0 = unlimited)" Margin="0,8,0,6"/>
            <TextBox x:Name="TorrentDownloadBox" Text="0" Width="160" HorizontalAlignment="Left"/>
            <TextBlock Text="Global torrent upload limit (KB/s, 0 = unlimited)" Margin="0,14,0,6"/>
            <TextBox x:Name="TorrentUploadBox" Text="0" Width="160" HorizontalAlignment="Left"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Separate from the toolbar's Speed Limiter, which only covers ordinary downloads."/>

            <TextBlock Text="Queueing" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <TextBlock Text="Upload slots per torrent" Margin="0,8,0,6"/>
            <Slider x:Name="TorrentSlots" Minimum="1" Maximum="20" Value="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding ElementName=TorrentSlots, Path=Value, StringFormat={}{0:0}}" FontWeight="SemiBold"/>
            <TextBlock Text="Maximum peers per torrent" Margin="0,12,0,6"/>
            <TextBox x:Name="TorrentMaxPeersBox" Text="60" Width="100" HorizontalAlignment="Left"/>

            <TextBlock Text="Seeding" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <CheckBox x:Name="TorrentSeedAfter" Content="Keep sharing a torrent after it finishes downloading" Margin="0,8,0,0"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="26,4,0,0"
                       Text="Off by default: a finished torrent just stops. To share one anyway, open its details window and choose Resume - nothing uploads until you say so."/>
            <CheckBox x:Name="TorrentSeedOnStart" Content="Resume sharing already-finished torrents when Makan starts" Margin="0,10,0,0"/>
            <TextBlock Text="Stop sharing once this much has been uploaded (%), 0 = never stop on ratio" Margin="0,16,0,6"/>
            <TextBox x:Name="TorrentRatioBox" Text="100" Width="100" HorizontalAlignment="Left"/>

            <TextBlock Text="Schedule" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"
                       Text="Downloading and seeding are different activities and often wanted at different times - each has its own hours here. A torrent outside its allowed hours simply pauses; it resumes by itself once the hours come back around. A time you paused by hand stays paused regardless."/>

            <CheckBox x:Name="TorrentDlScheduleOn" Content="Only download during these hours:" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="26,6,0,0">
              <TextBox x:Name="TorrentDlStart" Width="70" HorizontalContentAlignment="Center" ToolTip="24-hour time, for example 08:00"/>
              <TextBlock Text="to" Margin="8,4,8,0" VerticalAlignment="Center"/>
              <TextBox x:Name="TorrentDlStop" Width="70" HorizontalContentAlignment="Center" ToolTip="24-hour time, for example 23:00"/>
            </StackPanel>

            <CheckBox x:Name="TorrentSeedScheduleOn" Content="Only seed during these hours:" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="26,6,0,0">
              <TextBox x:Name="TorrentSeedStart" Width="70" HorizontalContentAlignment="Center" ToolTip="24-hour time, for example 23:00"/>
              <TextBlock Text="to" Margin="8,4,8,0" VerticalAlignment="Center"/>
              <TextBox x:Name="TorrentSeedStop" Width="70" HorizontalContentAlignment="Center" ToolTip="24-hour time, for example 07:00 (crossing midnight is fine)"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Proxy / Socks">
        <StackPanel Margin="18,14">
          <TextBlock Text="Route regular downloads through a proxy server (like IDM's Proxy/Socks tab). This applies to ordinary HTTP/HTTPS downloads only - not torrents or YouTube-style downloads, which have their own separate connections." TextWrapping="Wrap" Margin="0,0,0,14"/>
          <RadioButton x:Name="ProxyNone" Content="No proxy" GroupName="ProxyMode" Margin="0,0,0,8"/>
          <RadioButton x:Name="ProxySystem" Content="Use system settings" GroupName="ProxyMode" Margin="0,0,0,8"/>
          <RadioButton x:Name="ProxyManual" Content="Manual proxy configuration" GroupName="ProxyMode" Margin="0,0,0,10"/>
          <StackPanel x:Name="ProxyManualPanel" Margin="26,0,0,0">
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Proxy server address" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="ProxyHostBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Port" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="ProxyPortBox"/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Username (optional)" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="ProxyUsernameBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Password" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ProxyPasswordBox"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Use this proxy for:" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="ProxyForHttp" Content="http" Margin="0,0,18,0"/>
              <CheckBox x:Name="ProxyForHttps" Content="https"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"
                     Text="The password is stored encrypted, the same way everything else sensitive in Epsilon Download Manager is. A SOCKS proxy is not supported yet, only a regular HTTP proxy (most proxy servers, including SOCKS-capable ones, also accept plain HTTP proxy connections on a different port - check your provider)."/>
        </StackPanel>
      </TabItem>

      <TabItem Header="Remote">
        <StackPanel Margin="18,14">
          <TextBlock Text="View your downloads and add new ones from a phone's browser, on the same Wi-Fi/network - without a separate app." TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                     Text="Plain, unencrypted HTTP, meant for a home network only - never forward this port through a router to the internet. Anyone with the address below can see and add downloads, so only share it with people you trust on your own network."/>
          <CheckBox x:Name="RemoteOn" Content="Turn on the remote status page"/>
          <StackPanel x:Name="RemoteDetails" Margin="26,12,0,0">
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="Port:" VerticalAlignment="Center"/>
              <TextBox x:Name="RemotePortBox" Width="90" Margin="8,0,0,0" HorizontalAlignment="Left" DockPanel.Dock="Left"/>
            </DockPanel>
            <TextBlock Text="Open this on your phone's browser:" Margin="0,0,0,6"/>
            <TextBox x:Name="RemoteUrlBox" IsReadOnly="True" FontFamily="Consolas"/>
            <Button x:Name="RemoteCopyButton" Content="Copy" Click="RemoteCopy_Click" Padding="12,5" Margin="0,8,0,0" HorizontalAlignment="Left"/>
            <Button x:Name="RemoteNewTokenButton" Content="Get a new address (invalidates the old one)" Click="RemoteNewToken_Click" Padding="12,5" Margin="0,8,0,0" HorizontalAlignment="Left"/>
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
