<Window x:Class="MakanDownloadManager.DownloadCompleteWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download complete" Width="500" SizeToContent="Height" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
  <Border Style="{StaticResource CardBorder}" Margin="18" Padding="20"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="54" Height="54" CornerRadius="10" Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource Success}" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,16,0">
      <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1">
      <TextBlock Text="Download complete" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="NameText" Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="DetailText" Margin="0,4,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button Content="Open" Click="Open_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
        <Button Content="Open folder" Click="Folder_Click"/>
        <Button Content="Close" Click="Close_Click" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Grid></Border>
</Window>
