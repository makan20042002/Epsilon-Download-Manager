<Window x:Class="MakanDownloadManager.ThemedMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="500" MinWidth="380" MaxWidth="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Panel2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.76"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="12" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
          CornerRadius="18" ClipToBounds="True">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.48" Color="Black"/></Border.Effect>
    <Grid>
      <!-- Theme-neutral reflection over the theme's own panel colour. -->
      <Border CornerRadius="17" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#36FFFFFF" Offset="0"/>
            <GradientStop Color="#0EFFFFFF" Offset="0.22"/>
            <GradientStop Color="#00000000" Offset="0.52"/>
            <GradientStop Color="#16000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <DockPanel>
        <Border x:Name="DragArea" DockPanel.Dock="Top" Height="48" Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
          <Grid Margin="17,0,8,0">
            <TextBlock x:Name="CaptionText" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
            <Button HorizontalAlignment="Right" Width="34" Height="34" Margin="0" Padding="0" Click="Close_Click"
                    ToolTip="Close" Background="Transparent" BorderThickness="0" FontSize="20" Content="×"/>
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="18,14">
          <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>

        <Grid Margin="22,22,24,24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="IconBadge" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top"
                  CornerRadius="24" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.2">
            <Grid>
              <Ellipse Fill="{DynamicResource Accent}" Opacity="0.12" Margin="2"/>
              <Ellipse Stroke="#42FFFFFF" StrokeThickness="0.8" Margin="3"/>
              <TextBlock x:Name="IconGlyph" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
              <Ellipse Height="13" Margin="7,5,7,0" VerticalAlignment="Top" IsHitTestVisible="False">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#70FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
          </Border>
          <TextBlock x:Name="MessageText" Grid.Column="1" Margin="14,1,0,0" TextWrapping="Wrap"
                     FontSize="13.5" LineHeight="21" Foreground="{DynamicResource Text}"/>
        </Grid>
      </DockPanel>

      <!-- Always draw the complete rounded outline above header/body content. -->
      <Border CornerRadius="17" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity="0.52" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
