<Window Style="{StaticResource AppWindow}" x:Class="MakanDownloadManager.MediaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Media / Site Grabber" Width="900" Height="600" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="22,18"><StackPanel><TextBlock Text="Media &amp; Site Grabber" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Inspect HLS, DASH and page assets before downloading." Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="22,16,22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBox x:Name="Url" Padding="9" ToolTip="Stream or webpage URL"/><TextBox x:Name="Ffmpeg" Grid.Column="1" Padding="9" Margin="10,0,0,0" ToolTip="Path to ffmpeg.exe"/></Grid>
<Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="22,12"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,10,12,12"><Button Content="Inspect manifest" Click="Inspect_Click"/><Button Content="Grab page assets" Click="Grab_Click"/><Button Content="Download selected" Click="Download_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Download source" Click="Source_Click"/></StackPanel>
<ListView x:Name="Streams" Background="{DynamicResource Surface}" BorderThickness="0" Margin="1"><ListView.View><GridView><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="100"/><GridViewColumn Header="Quality" DisplayMemberBinding="{Binding Quality}" Width="130"/><GridViewColumn Header="Codec" DisplayMemberBinding="{Binding Codec}" Width="220"/><GridViewColumn Header="Bitrate" DisplayMemberBinding="{Binding Bitrate}" Width="110"/><GridViewColumn Header="Language" DisplayMemberBinding="{Binding Language}" Width="120"/></GridView></ListView.View></ListView></DockPanel></Border>
<Border Grid.Row="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="22,10"><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></Border>
</Grid></Window>
