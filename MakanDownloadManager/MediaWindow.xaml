<Window Style="{StaticResource AppWindow}" x:Class="MakanDownloadManager.MediaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Media / Site Grabber" Width="900" Height="600" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0"><TextBlock Text="Media &amp; Site Grabber" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="HLS (.m3u8), DASH (.mpd), stream inspection and FFmpeg extraction" Foreground="{DynamicResource Muted}" Margin="0,4,0,14"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBox x:Name="Url" Padding="9" ToolTip="Stream or webpage URL"/><TextBox x:Name="Ffmpeg" Grid.Column="1" Padding="9" Margin="10,0,0,0" ToolTip="Path to ffmpeg.exe"/></Grid>
<DockPanel Grid.Row="2" Margin="0,12"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Inspect manifest" Click="Inspect_Click"/><Button Content="Grab page assets" Click="Grab_Click"/><Button Content="Download selected" Click="Download_Click" Background="{DynamicResource AccentDark}" Foreground="{DynamicResource OnAccent}"/><Button Content="Download source" Click="Source_Click"/></StackPanel>
<ListView x:Name="Streams" Background="{DynamicResource Panel}" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="100"/><GridViewColumn Header="Quality" DisplayMemberBinding="{Binding Quality}" Width="130"/><GridViewColumn Header="Codec" DisplayMemberBinding="{Binding Codec}" Width="220"/><GridViewColumn Header="Bitrate" DisplayMemberBinding="{Binding Bitrate}" Width="110"/><GridViewColumn Header="Language" DisplayMemberBinding="{Binding Language}" Width="120"/></GridView></ListView.View></ListView></DockPanel>
<TextBlock Grid.Row="3" x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
</Grid></Window>
