<Window Style="{StaticResource AppWindow}" x:Class="MakanDownloadManager.SchedulerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Scheduler" Width="800" Height="640" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}">
  <Window.Resources>
    <!-- DatePicker and display-member list cells otherwise keep Windows' light-theme text colours. -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style TargetType="primitives:DatePickerTextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Input}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style TargetType="DatePicker">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Input}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- queues -->
    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Text="Queues" FontWeight="SemiBold" Margin="0,0,0,6" HorizontalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="New queue" Click="NewQueue_Click" MinWidth="90"/>
        <Button x:Name="DeleteQueueButton" Content="Delete" Click="DeleteQueue_Click" MinWidth="70"/>
      </StackPanel>
      <ListBox x:Name="QueueList" SelectionChanged="QueueList_SelectionChanged" Background="{DynamicResource Surface}"/>
    </DockPanel>

    <!-- selected queue -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <TextBlock x:Name="RunningText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
        <TextBox x:Name="NameBox" FontSize="16" FontWeight="SemiBold" Padding="4" ToolTip="Queue name (the main queue keeps its name)"/>
      </DockPanel>

      <TabControl Grid.Row="1" x:Name="Tabs">
        <TabItem Header="Schedule">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,6">
              <CheckBox x:Name="StartOnStartup" Content="Start download when Makan starts" Margin="0,0,0,10"/>

              <CheckBox x:Name="UseGlobalParallel" Content="Use the simultaneous-download limit from Options" Margin="0,0,0,6" Checked="UseGlobalParallel_Changed" Unchecked="UseGlobalParallel_Changed"/>
              <StackPanel x:Name="ParallelPanel" Orientation="Horizontal" Margin="26,0,0,12">
                <TextBlock Text="Download" VerticalAlignment="Center"/>
                <Border Margin="10,0" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface}">
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ParallelBox" Width="46" BorderThickness="0" HorizontalContentAlignment="Center" Text="4" ToolTip="1 to 16"/>
                    <StackPanel>
                      <Button Click="ParallelUp_Click" Padding="7,1" Margin="0" BorderThickness="0" Background="Transparent"><TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="9"/></Button>
                      <Button Click="ParallelDown_Click" Padding="7,1" Margin="0" BorderThickness="0" Background="Transparent"><TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"/></Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="files at the same time in this queue" VerticalAlignment="Center"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox x:Name="StartAt" Content="Start download at" VerticalAlignment="Center"/>
                <TextBox x:Name="StartTime" Width="70" Margin="10,0,0,0" Padding="3" HorizontalContentAlignment="Center" ToolTip="24-hour time, for example 23:30"/>
                <TextBlock Text="(24-hour, e.g. 23:30)" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Margin="26,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <RadioButton x:Name="OnceRadio" Content="Once on" GroupName="When" VerticalAlignment="Center"/>
                  <DatePicker x:Name="OnceDate" Margin="10,0,0,0" Width="170"/>
                </StackPanel>
                <RadioButton x:Name="DailyRadio" Content="Daily, on:" GroupName="When" IsChecked="True" Margin="0,0,0,4"/>
                <UniformGrid Columns="3" Margin="22,0,0,0" Width="380" HorizontalAlignment="Left">
                  <CheckBox x:Name="DaySun" Content="Sunday"/><CheckBox x:Name="DayWed" Content="Wednesday"/><CheckBox x:Name="DaySat" Content="Saturday"/>
                  <CheckBox x:Name="DayMon" Content="Monday"/><CheckBox x:Name="DayThu" Content="Thursday"/><TextBlock/>
                  <CheckBox x:Name="DayTue" Content="Tuesday"/><CheckBox x:Name="DayFri" Content="Friday"/><TextBlock/>
                </UniformGrid>
              </StackPanel>

              <Separator Margin="0,12"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="StopAt" Content="Stop download at" VerticalAlignment="Center"/>
                <TextBox x:Name="StopTime" Width="70" Margin="10,0,0,0" Padding="3" HorizontalContentAlignment="Center" ToolTip="24-hour time, for example 07:30"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="RetriesOn" Content="Number of retries for each file if downloading failed:" VerticalAlignment="Center"/>
                <TextBox x:Name="RetriesBox" Width="50" Margin="10,0,0,0" Padding="3" HorizontalContentAlignment="Center"/>
              </StackPanel>

              <Separator Margin="0,4,0,12"/>
              <TextBlock Text="When every download in the queue is finished:" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
              <CheckBox x:Name="OpenOn" Content="Open the following file:" Margin="0,0,0,4"/>
              <DockPanel Margin="26,0,0,10">
                <Button DockPanel.Dock="Right" Content="…" Click="BrowseOpen_Click" MinWidth="34"/>
                <TextBox x:Name="OpenPath" Padding="4"/>
              </DockPanel>
              <CheckBox x:Name="ExitOn" Content="Exit Makan" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="PowerOn" Content="Turn off the computer:" VerticalAlignment="Center"/>
                <ComboBox x:Name="PowerBox" Width="130" Margin="10,0,0,0">
                  <ComboBoxItem Content="Shut down"/><ComboBoxItem Content="Hibernate"/><ComboBoxItem Content="Sleep"/><ComboBoxItem Content="Restart"/>
                </ComboBox>
              </StackPanel>
              <CheckBox x:Name="ForceOn" Content="Force programs to close (unsaved work is lost)" Margin="26,6,0,0"/>
              <TextBlock Text="A 60-second warning with a Cancel button is always shown before the computer is turned off." Foreground="{DynamicResource Muted}" Margin="26,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Files in the queue">
          <DockPanel Margin="10">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Click="Down_Click" ToolTip="Move down" Padding="12,6"><TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Accent}"/></Button>
              <Button Click="Up_Click" ToolTip="Move up" Padding="12,6"><TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Accent}"/></Button>
              <Button Click="RemoveFile_Click" ToolTip="Remove from queue" Padding="12,6"><TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Danger}"/></Button>
            </StackPanel>
            <ListView x:Name="FilesList" SelectionMode="Extended" Background="{DynamicResource Surface}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="File Name" Width="300" DisplayMemberBinding="{Binding FileName}"/>
                  <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeDisplay}"/>
                  <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding StatusText}"/>
                  <GridViewColumn Header="Time left" Width="80" DisplayMemberBinding="{Binding TimeLeft}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
      </TabControl>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="StartNowButton" Content="Start now" Click="StartNow_Click" MinWidth="90" Background="{DynamicResource AccentDark}" Foreground="{DynamicResource OnAccent}"/>
        <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" MinWidth="90"/>
        <Button Content="Apply" Click="Apply_Click" MinWidth="90"/>
        <Button Content="Close" Click="Close_Click" MinWidth="90" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
