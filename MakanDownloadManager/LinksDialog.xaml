<Window Style="{StaticResource AppWindow}" x:Class="MakanDownloadManager.LinksDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download All Links with Epsilon" Width="1120" Height="680" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="22,18"><StackPanel><TextBlock Text="Website Grabber" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Review, filter and queue every link captured from the page." Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel></Border>

    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="22,14,22,8" Foreground="{DynamicResource Muted}"
               Text="Tick the links you want, then choose Start Download or Download Later. You may wait while Epsilon checks the sizes and file types."/>

    <DataGrid x:Name="Grid" Grid.Row="2" Margin="22,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" SelectionMode="Extended" Background="{DynamicResource Surface}" RowHeaderWidth="0" BorderBrush="{DynamicResource Border}" EnableRowVirtualization="True">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
        <DataGridTextColumn Header="File Name" Binding="{Binding FileName, Mode=TwoWay}" Width="230"/>
        <DataGridTextColumn Header="File Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="120"/>
        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" IsReadOnly="True" Width="85"/>
        <DataGridTextColumn Header="Download from" Binding="{Binding Url}" IsReadOnly="True" Width="270"/>
        <DataGridTextColumn Header="Save to" Binding="{Binding SavePath}" IsReadOnly="True" Width="250"/>
        <DataGridTextColumn Header="Link Text" Binding="{Binding Text}" IsReadOnly="True" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="3" Margin="22,12,22,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <GroupBox Header="Save to" Padding="8,6">
        <StackPanel>
          <RadioButton x:Name="ByCategory" GroupName="SaveMode" Content="Every file to the folder for its category (Video, Music, Programs…)" IsChecked="True" Checked="SaveMode_Changed" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton x:Name="OneCategory" Content="All files to one category:" GroupName="SaveMode" Checked="SaveMode_Changed" VerticalAlignment="Center"/>
            <ComboBox x:Name="CategoryBox" Width="150" Margin="8,0,0,0" SelectionChanged="SaveMode_Changed"/>
          </StackPanel>
          <DockPanel>
            <RadioButton x:Name="OneFolder" GroupName="SaveMode" DockPanel.Dock="Left" Content="All files to one folder:" Checked="SaveMode_Changed" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/>
            <TextBox x:Name="FolderBox" Margin="8,0,0,0" Padding="4" TextChanged="FolderBox_TextChanged"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" MinWidth="250">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Check All" Click="CheckAll_Click" MinWidth="100"/><Button Content="Uncheck All" Click="UncheckAll_Click" MinWidth="100"/>
        </StackPanel>
        <CheckBox x:Name="HideHtml" Content="Hide web pages (HTML)" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,4"/>
        <CheckBox x:Name="HideImages" Content="Hide images of this page" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,0,4"/>
        <TextBlock x:Name="CountText" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="4" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="22,14" Margin="0,12,0,0"><DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Start Download" Click="Start_Click" MinWidth="120" Background="{DynamicResource AccentDark}" Foreground="{DynamicResource OnAccent}"/>
        <Button Content="Download Later" Click="Later_Click" MinWidth="120"/>
        <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="90"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="QueueLabel" Text="Download queue:" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
        <ComboBox x:Name="QueueBox" Width="220" Margin="8,0,0,0" DisplayMemberPath="Name"/>
        <Button Content="New queue…" Click="NewQueue_Click" Margin="8,0,0,0"/>
      </StackPanel>
    </DockPanel></Border>
  </Grid>
</Window>
