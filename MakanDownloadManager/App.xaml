<Application x:Class="MakanDownloadManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Colours. These are the LIGHT values; ThemeManager (ThemeManager.cs / Services/ThemePalette.cs) replaces them when the dark
         "blue grey" theme is chosen, so every window must refer to them with DynamicResource. -->
    <SolidColorBrush x:Key="Bg" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="Panel" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="Panel2" Color="#E8EDF6"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border" Color="#E1E6EE"/>
    <SolidColorBrush x:Key="Text" Color="#1B2430"/>
    <SolidColorBrush x:Key="Muted" Color="#5F6B7A"/>
    <SolidColorBrush x:Key="Faint" Color="#8A93A3"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6FEB"/>
    <SolidColorBrush x:Key="AccentDark" Color="#1F56C4"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#EDF2FC"/>
    <SolidColorBrush x:Key="Selected" Color="#DCE7FC"/>
    <SolidColorBrush x:Key="Success" Color="#15803D"/>
    <SolidColorBrush x:Key="Danger" Color="#C62828"/>
    <SolidColorBrush x:Key="Warning" Color="#B45309"/>
    <SolidColorBrush x:Key="SuccessBg" Color="#E7F6EC"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#F8FAFD"/>
    <SolidColorBrush x:Key="Track" Color="#E3E8F1"/>
    <SolidColorBrush x:Key="Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder" Color="#CBD2DE"/>
    <SolidColorBrush x:Key="Popup" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="IconGrey" Color="#5B6577"/>
    <SolidColorBrush x:Key="IconPurple" Color="#7C3AED"/>
    <SolidColorBrush x:Key="IconTeal" Color="#0E7490"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#C3CAD6"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A7B0BF"/>
    <SolidColorBrush x:Key="Disabled" Color="#9AA3B0"/>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- every window: font, colours, crisp rendering (assign with Style="{StaticResource AppWindow}") -->
    <Style x:Key="AppWindow" TargetType="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- buttons: rounded, flat; explicit Background/Foreground on a button still win (used for the blue primary buttons) -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="StatusPill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentDark}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- inputs -->
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource Input}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TreeViewItem"><Setter Property="Padding" Value="2,4"/></Style>
    <!-- ComboBox, CheckBox, RadioButton, GroupBox, TabControl, Menu, ScrollBar, list headers ... : Themes/ControlStyles.xaml,
         loaded (and tested) at start-up by ThemeManager so a dark theme is possible; without it the standard Windows look is used. -->
  </Application.Resources>
</Application>
