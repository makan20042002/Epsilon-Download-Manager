<Window Style="{StaticResource AppWindow}" x:Class="MakanDownloadManager.PowerCountdownWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epsilon Download Manager" Width="470" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}">
  <StackPanel Margin="22">
    <TextBlock x:Name="MessageText" FontSize="15" TextWrapping="Wrap"/>
    <TextBlock x:Name="CountText" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
    <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Do it now" Click="Now_Click" MinWidth="100"/>
      <Button Content="Cancel" IsCancel="True" IsDefault="True" Click="Cancel_Click" MinWidth="100"/>
    </StackPanel>
  </StackPanel>
</Window>
