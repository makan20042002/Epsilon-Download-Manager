<Window x:Class="MakanDownloadManager.DownloadProgressWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download" Width="980" MinWidth="720" SizeToContent="Height" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource Text}">

  <!-- Borderless window Chrome with custom title bar matching Epsilon website .eps-window showcase -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="Mono">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Compact Windows-style caption controls: clear line icons, no traffic-light dots. -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Danger}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .eps-mainbar: 12px clean rectangular bar -->
    <Style x:Key="MainBarStyle" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Track}"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border x:Name="TemplateRoot" Background="{TemplateBinding Background}" CornerRadius="0" ClipToBounds="True">
              <Border x:Name="PART_Track">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="0">
                </Border>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .eps-conn-bar: 6px clean rectangular bar -->
    <Style x:Key="ConnBarStyle" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource AccentDark}"/>
      <Setter Property="Background" Value="{DynamicResource Track}"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border x:Name="TemplateRoot" Background="{TemplateBinding Background}" CornerRadius="0" ClipToBounds="True">
              <Border x:Name="PART_Track">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="0"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Outlined buttons -->
    <Style x:Key="OutlineButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Gradient primary button -->
    <Style x:Key="GradButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interactive chips (.eps-chip) -->
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="3" Padding="11,4" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <!-- Stat labels matching .eps-stats span -->
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <!-- Tabs of the details area (Overview, Segments, ...) -->
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Padding="13,8" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 1 min / 5 min / 30 min switch of the speed graph -->
    <Style x:Key="RangeChip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="3" Padding="9,3" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MiniCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,0,12,8"/>
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>

  <!-- A one-pixel transparent breathing edge is enough for real rounded corners without recreating
       the large empty gutter that the previous inset frame caused. -->
  <Border x:Name="WindowFrame" Margin="1" Background="{DynamicResource Aurora}" BorderBrush="{DynamicResource GlassEdge}"
          BorderThickness="1" CornerRadius="18" ClipToBounds="True">
    <Grid>
      <!-- Soft glass reflection shared by every theme; the theme panel remains the base colour. -->
      <Border CornerRadius="17" IsHitTestVisible="False" Opacity="0.72">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#32FFFFFF" Offset="0"/>
            <GradientStop Color="#0CFFFFFF" Offset="0.20"/>
            <GradientStop Color="#00000000" Offset="0.52"/>
            <GradientStop Color="#12000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <DockPanel>

      <!-- ============ .eps-window-bar title bar ============ -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Height="44">
        <DockPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,5,0">
            <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize">
              <Viewbox Width="14" Height="14"><Canvas Width="14" Height="14"><Path Data="M 2 10.5 H 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Square"/></Canvas></Viewbox>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize">
              <Viewbox Width="14" Height="14"><Canvas Width="14" Height="14"><Path x:Name="MaximizeGlyph" Data="M 2.5 2.5 H 11.5 V 11.5 H 2.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/></Canvas></Viewbox>
            </Button>
            <Button Style="{StaticResource CaptionCloseButton}" Click="CloseWindow_Click" ToolTip="Close">
              <Viewbox Width="14" Height="14"><Canvas Width="14" Height="14"><Path Data="M 3 3 L 11 11 M 11 3 L 3 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Square"/></Canvas></Viewbox>
            </Button>
          </StackPanel>

          <Border x:Name="ConnPill" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,12,0" CornerRadius="3" Padding="10,3"
                  BorderBrush="{DynamicResource Success}" BorderThickness="1" Background="{DynamicResource SuccessBg}">
            <TextBlock x:Name="ConnCountText" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Success}"/>
          </Border>

          <TextBlock x:Name="TitleText" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"
                     FontFamily="{StaticResource Mono}" FontSize="13" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>

      <!-- ============ .eps-window-body ============ -->
      <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False" Focusable="False">
      <StackPanel Margin="24,20,24,22">

        <!-- File title & URL, with an icon tile -->
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="56" Height="56" CornerRadius="16" Margin="0,0,16,0" VerticalAlignment="Center" Background="{DynamicResource BrandGrad}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1">
            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="FileNameText" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="UrlText" Foreground="{DynamicResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>

        <!-- Hero: big percentage + main bar on the left, live speed on the right -->
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="220"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="22,16">
            <StackPanel>
              <TextBlock x:Name="PercentText" FontFamily="{StaticResource Mono}" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Left"/>
              <ProgressBar x:Name="MainBar" Style="{StaticResource MainBarStyle}" Minimum="0" Maximum="100" Margin="0,8,0,10" VerticalAlignment="Center"/>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource StatLabel}" Text="TIME LEFT" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="EtaText" Style="{StaticResource StatValue}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="DownloadedText" Style="{StaticResource StatValue}" FontSize="14" Foreground="{DynamicResource Muted}"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Text="DOWNLOAD SPEED"/>
              <TextBlock x:Name="RateText" Style="{StaticResource StatValue}" FontSize="26" Foreground="{DynamicResource Accent}" Margin="0,2,0,8"/>
              <TextBlock Style="{StaticResource StatLabel}" Text="STATUS"/>
              <TextBlock x:Name="StatusText" Style="{StaticResource StatValue}" FontSize="15"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Saved partial data recovered at resume. This stays separate from the network progress above, so a user
             can immediately see that Epsilon found and loaded the existing data instead of appearing stuck. -->
        <StackPanel x:Name="DiskLoadPanel" Margin="0,9,0,0" Visibility="Collapsed">
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="DISK LOAD" Style="{StaticResource StatLabel}" Margin="0" Foreground="{DynamicResource Warning}"/>
            <TextBlock x:Name="DiskLoadText" Grid.Column="1" Style="{StaticResource StatLabel}" Margin="12,0" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DiskLoadPercentText" Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" MinWidth="48" TextAlignment="Right"/>
          </Grid>
          <ProgressBar x:Name="DiskLoadBar" Style="{StaticResource MainBarStyle}" Foreground="{DynamicResource Warning}" Height="7" Minimum="0" Maximum="100"/>
        </StackPanel>

        <!-- Details: Overview / Segments / Connections / Sources / Multi-Network / Logs -->
        <StackPanel x:Name="DetailsPanel" Margin="0,20,0,0">
          <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
            <WrapPanel>
              <RadioButton x:Name="TabOverview" Style="{StaticResource TabButton}" GroupName="ProgressTabs" Tag="Overview" Content="Overview" IsChecked="True" Checked="Tab_Checked"/>
              <RadioButton Style="{StaticResource TabButton}" GroupName="ProgressTabs" Tag="Segments" Content="Segments" Checked="Tab_Checked"/>
              <RadioButton Style="{StaticResource TabButton}" GroupName="ProgressTabs" Tag="Connections" Content="Connections" Checked="Tab_Checked"/>
              <RadioButton Style="{StaticResource TabButton}" GroupName="ProgressTabs" Tag="Sources" Content="Sources" Checked="Tab_Checked"/>
              <RadioButton Style="{StaticResource TabButton}" GroupName="ProgressTabs" Tag="Networks" Content="Multi-Network" Checked="Tab_Checked"/>
              <RadioButton Style="{StaticResource TabButton}" GroupName="ProgressTabs" Tag="Logs" Content="Logs" Checked="Tab_Checked"/>
            </WrapPanel>
          </Border>

          <Grid>
            <!-- ================= Overview ================= -->
            <StackPanel x:Name="PanelOverview">
              <UniformGrid Columns="5" Margin="0,0,-8,12">
                <Border Style="{StaticResource MiniCard}"><StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource StatLabel}" Text="CONNECTIONS" VerticalAlignment="Center"/></StackPanel>
                  <TextBlock x:Name="StatConnections" Style="{StaticResource StatValue}" FontSize="14"/>
                </StackPanel></Border>
                <Border Style="{StaticResource MiniCard}"><StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource StatLabel}" Text="SEGMENTS" VerticalAlignment="Center"/></StackPanel>
                  <TextBlock x:Name="StatSegments" Style="{StaticResource StatValue}" FontSize="14"/>
                </StackPanel></Border>
                <Border Style="{StaticResource MiniCard}"><StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource StatLabel}" Text="ACTIVE SOURCES" VerticalAlignment="Center"/></StackPanel>
                  <TextBlock x:Name="StatSources" Style="{StaticResource StatValue}" FontSize="14"/>
                </StackPanel></Border>
                <Border Style="{StaticResource MiniCard}"><StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource StatLabel}" Text="MULTI-NETWORK" VerticalAlignment="Center"/></StackPanel>
                  <TextBlock x:Name="StatMulti" Style="{StaticResource StatValue}" FontSize="14"/>
                </StackPanel></Border>
                <Border Style="{StaticResource MiniCard}"><StackPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Style="{StaticResource StatLabel}" Text="UPLOAD" VerticalAlignment="Center"/></StackPanel>
                  <TextBlock x:Name="StatUpload" Style="{StaticResource StatValue}" FontSize="14"/>
                </StackPanel></Border>
              </UniformGrid>

            <StackPanel x:Name="PanelSegments" Margin="0,0,0,12">
              <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatLabel}" Text="DOWNLOAD SEGMENTS" Margin="0"/>
                <TextBlock x:Name="SegmentSummaryText" HorizontalAlignment="Right" Style="{StaticResource StatLabel}" Margin="0"/>
              </DockPanel>
              <Border Style="{StaticResource Card}" Padding="12">
                <UniformGrid x:Name="SegmentGrid" Rows="2" Columns="50"/>
              </Border>
              <WrapPanel Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBlock x:Name="LegDownloading" Style="{StaticResource StatLabel}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource Success}" VerticalAlignment="Center"/><TextBlock x:Name="LegComplete" Style="{StaticResource StatLabel}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource Faint}" VerticalAlignment="Center"/><TextBlock x:Name="LegWaiting" Style="{StaticResource StatLabel}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,4"><Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource Danger}" VerticalAlignment="Center"/><TextBlock x:Name="LegError" Style="{StaticResource StatLabel}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource Track}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" VerticalAlignment="Center"/><TextBlock x:Name="LegUnassigned" Style="{StaticResource StatLabel}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </WrapPanel>
            </StackPanel>


              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="190"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
                <!-- speed graph -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton x:Name="Range1" Style="{StaticResource RangeChip}" GroupName="SpeedRange" Tag="60" Content="1 min" IsChecked="True" Checked="Range_Checked"/>
                        <RadioButton Style="{StaticResource RangeChip}" GroupName="SpeedRange" Tag="300" Content="5 min" Checked="Range_Checked"/>
                        <RadioButton Style="{StaticResource RangeChip}" GroupName="SpeedRange" Tag="1800" Content="30 min" Checked="Range_Checked"/>
                      </StackPanel>
                      <TextBlock Style="{StaticResource StatLabel}" Text="SPEED GRAPH" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Height="130">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid Margin="0,0,8,0" MinWidth="58">
                        <TextBlock x:Name="AxisTop" Style="{StaticResource StatLabel}" Margin="0" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="10"/>
                        <TextBlock x:Name="AxisMid" Style="{StaticResource StatLabel}" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/>
                        <TextBlock x:Name="AxisBottom" Text="0" Style="{StaticResource StatLabel}" Margin="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="10"/>
                      </Grid>
                      <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,1">
                        <Canvas x:Name="SpeedCanvas" ClipToBounds="True" Background="Transparent" SizeChanged="SpeedCanvas_SizeChanged">
                          <Polygon x:Name="SpeedFill" Fill="{DynamicResource Accent}" Opacity="0.16"/>
                          <Polyline x:Name="SpeedLine" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                          <Polyline x:Name="UploadLine" Stroke="{DynamicResource IconPurple}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        </Canvas>
                      </Border>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Border Width="12" Height="3" Background="{DynamicResource Accent}" VerticalAlignment="Center"/><TextBlock Text="Download" Style="{StaticResource StatLabel}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Border Width="12" Height="3" Background="{DynamicResource IconPurple}" VerticalAlignment="Center"/><TextBlock Text="Upload" Style="{StaticResource StatLabel}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                      <TextBlock x:Name="GraphSummaryText" Style="{StaticResource StatLabel}" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <!-- network breakdown -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="NETWORK BREAKDOWN" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="NetList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"/>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ConnBarStyle}" Value="{Binding Percent, Mode=OneWay}" Margin="0,5,0,0"/>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NetEmptyText" Text="No connections yet" Foreground="{DynamicResource Faint}" FontSize="12"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>

            <!-- ================= Connections (up to the V2 48-connection advanced maximum) ================= -->
            <StackPanel x:Name="PanelConnections" Visibility="Collapsed">
              <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatLabel}" Text="CONNECTIONS" Margin="0" FontSize="11" Foreground="{DynamicResource Faint}"/>
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource StatLabel}" Margin="0" Text="Start positions and download progress by connections"/>
              </DockPanel>

              <Border Height="6" CornerRadius="1" Background="{DynamicResource Track}" ClipToBounds="True" Margin="0,0,0,14">
                <UniformGrid x:Name="PositionGrid" Rows="1"/>
              </Border>

              <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ConnList">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- .eps-conn: grid template 34px 1fr 70px -->
                      <Grid Margin="0,4,16,4" ToolTip="{Binding Info}" Background="Transparent">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/><ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="Bar" Grid.Column="1" Style="{StaticResource ConnBarStyle}" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Network}" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="{DynamicResource IconPurple}" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Network}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Sp" Grid.Column="3" Text="{Binding SpeedText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Faint}" TextAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                          <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Success}"/>
                          <Setter TargetName="Sp" Property="Foreground" Value="{DynamicResource Success}"/>
                          <Setter TargetName="Sp" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>

            <!-- ================= Sources ================= -->
            <StackPanel x:Name="PanelSources" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="ADDRESS"/>
                  <TextBlock x:Name="SourceUrlText" Grid.Column="1" Style="{StaticResource FieldValue}" FontFamily="{StaticResource Mono}" FontSize="11.5"/>
                  <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="SERVER"/>
                  <TextBlock x:Name="SourceHostText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                  <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="SECURITY"/>
                  <TextBlock x:Name="SourceSecurityText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                  <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="RESUME"/>
                  <TextBlock x:Name="SourceResumeText" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                  <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="ACTIVE SOURCES"/>
                  <TextBlock x:Name="SourceCountText" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Margin="0"/>
                </Grid>
              </Border>
            </StackPanel>

            <!-- ================= Multi-Network ================= -->
            <StackPanel x:Name="PanelNetworks" Visibility="Collapsed">
              <TextBlock x:Name="MultiStatusText" Style="{StaticResource StatLabel}" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <Border Style="{StaticResource Card}">
                <ItemsControl x:Name="NetListFull">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConnectionsText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding BytesText}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextAlignment="Right"/>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource ConnBarStyle}" Value="{Binding Percent, Mode=OneWay}" Margin="0,6,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <!-- ================= Logs ================= -->
            <StackPanel x:Name="PanelLogs" Visibility="Collapsed">
              <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Margin="0" Click="CopyLog_Click"><TextBlock Text="Copy log"/></Button>
                <TextBlock Style="{StaticResource StatLabel}" Text="WHAT HAPPENED WHILE THIS WINDOW WAS OPEN" Margin="0" VerticalAlignment="Center"/>
              </DockPanel>
              <Border Style="{StaticResource Card}" Padding="0">
                <ScrollViewer x:Name="LogScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="LogList" Margin="14,10">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- .eps-window-foot: action chips -->
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
          <WrapPanel x:Name="FootPanel">
            <Border Style="{StaticResource Chip}"><TextBlock x:Name="SizeText" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}"/></Border>
            <Border x:Name="ResumeChip" Style="{StaticResource Chip}"><TextBlock x:Name="ResumeText" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}"/></Border>
            <Button Style="{StaticResource ChipButton}" Click="Options_Click"><TextBlock x:Name="LimiterChipText"/></Button>
            <Button Style="{StaticResource ChipButton}" Click="Options_Click"><TextBlock x:Name="CompletionChipText"/></Button>
            <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource Success}"><TextBlock Text="SHA-256 ✓ on finish" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Success}"/></Border>
          </WrapPanel>
        </Border>

        <!-- status footer: SHA-256 verification and where the file is saved -->
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="SHA-256 verification:" Style="{StaticResource StatLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="Sha256Text" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,10,0">
            <TextBlock Text="Save to:" Style="{StaticResource StatLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SaveFooterText" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="330" VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="ChangeSaveButton" Grid.Column="2" Style="{StaticResource OutlineButton}" Content="Change" Height="30" MinWidth="76" FontSize="12" Click="ChangeSave_Click"/>
        </Grid>

        <!-- options: speed limiter + on completion -->
        <Grid x:Name="OptionsPanel" Margin="0,8,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Text="Speed Limiter" Foreground="{DynamicResource Accent}"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Transfer rate" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/>
                <TextBlock x:Name="LimiterRate" FontWeight="SemiBold"/>
              </StackPanel>
              <CheckBox x:Name="UseLimiter" Content="Use Speed Limiter" Margin="0,12,0,0" Checked="Limiter_Changed" Unchecked="Limiter_Changed"/>
              <TextBlock Text="Maximum download speed:" Foreground="{DynamicResource Muted}" Margin="0,10,0,4"/>
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="LimitBox" Width="90" Text="500" TextChanged="Limiter_Text_Changed"/>
                <TextBlock Text="KBytes/sec" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Muted}"/>
              </StackPanel>
              <CheckBox x:Name="RememberLimit" Margin="0,12,0,0" Checked="Limiter_Changed" Unchecked="Limiter_Changed">
                <TextBlock Text="Remember Speed Limiter settings for this file on download stop/resume" TextWrapping="Wrap"/>
              </CheckBox>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Text="Options on completion" Foreground="{DynamicResource Accent}"/>
              <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Save To:" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                <TextBlock x:Name="SaveToText" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <CheckBox x:Name="ShowCompleteBox" Content="Show download complete dialog" Margin="0,10,0,0" Checked="Completion_Changed" Unchecked="Completion_Changed"/>
              <TextBlock Text="These settings are unavailable when 'Show download complete dialog' is turned on" Foreground="{DynamicResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,6"/>
              <CheckBox x:Name="ExitBox" Content="Exit Epsilon when done" Margin="0,3" Checked="Completion_Changed" Unchecked="Completion_Changed"/>
              <CheckBox x:Name="PowerBox" Content="Turn off computer when done" Margin="0,3" Checked="Completion_Changed" Unchecked="Completion_Changed"/>
              <ComboBox x:Name="PowerCombo" Width="150" HorizontalAlignment="Left" Margin="24,4,0,0" SelectedIndex="0" SelectionChanged="Completion_Changed">
                <ComboBoxItem Content="Shut down"/><ComboBoxItem Content="Hibernate"/><ComboBoxItem Content="Sleep"/><ComboBoxItem Content="Restart"/>
              </ComboBox>
              <CheckBox x:Name="ForceBox" Content="Force processes to terminate" Margin="24,6,0,0" Checked="Completion_Changed" Unchecked="Completion_Changed"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- buttons -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="DetailsButton" Style="{StaticResource OutlineButton}" Content="&lt;&lt; Hide details" Click="Details_Click"/>
          <Button x:Name="OptionsButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Content="Options" Click="Options_Click" Margin="8,0,0,0"/>
          <Button x:Name="StartPauseButton" Grid.Column="3" Style="{StaticResource GradButton}" Content="Pause" Click="StartPause_Click"/>
          <Button Grid.Column="4" Style="{StaticResource OutlineButton}" Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0" MinWidth="90"/>
        </Grid>

      </StackPanel>
      </ScrollViewer>
      </DockPanel>

      <!-- Draw the frame last so the title bar can never cover the upper-left or upper-right arc. -->
      <Border CornerRadius="17" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
              Opacity="0.56" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
