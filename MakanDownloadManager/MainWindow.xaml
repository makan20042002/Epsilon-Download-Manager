<Window x:Class="MakanDownloadManager.MainWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epsilon Download Manager — Intelligent Download Center" Width="1200" Height="700" MinWidth="900" MinHeight="480" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <!-- toolbar button: icon over a small caption, rounded hover -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="MinWidth" Value="66"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="8,7">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="6,8"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- a row in the toolbar's "More" overflow popup: icon on the left, full-width label, left-aligned -->
    <Style x:Key="ToolMenuRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- list rows: roomy, hover and selection colours, thin separators -->
    <Style x:Key="RowStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="4,7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- menu bar (same structure as IDM) -->
    <Menu DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="4,2">
      <MenuItem Header="_Tasks">
        <MenuItem Header="Add _new download…" InputGestureText="Ctrl+N" Click="Add_Click"/>
        <MenuItem Header="Add _torrent or magnet link…" Click="AddTorrent_Click"/>
        <MenuItem Header="Add _batch download…" Click="AddBatch_Click"/>
        <MenuItem Header="Add batch download from _clipboard" InputGestureText="Ctrl+V" Click="BatchClipboard_Click"/>
        <MenuItem Header="Run site _grabber…" Click="SiteGrabber_Click"/>
        <Separator/>
        <MenuItem x:Name="ShowDropTarget" Header="Show _drop target" IsCheckable="True" Click="ShowDropTarget_Click"/>
        <Separator/>
        <MenuItem Header="_Export">
          <MenuItem Header="To _text file…" Click="ExportText_Click"/>
        </MenuItem>
        <MenuItem Header="_Import">
          <MenuItem Header="From _text file…" Click="ImportText_Click"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_File">
        <MenuItem Header="_Open" InputGestureText="Enter" Click="Open_Click"/>
        <MenuItem Header="Open _folder" Click="OpenFolder_Click"/>
        <MenuItem Header="_Copy address" Click="CopyUrl_Click"/>
        <Separator/>
        <MenuItem Header="Export _diagnostic report" Click="Diagnostics_Click"/>
      </MenuItem>
      <MenuItem Header="_Downloads">
        <MenuItem Header="_Resume" Click="Start_Click"/>
        <MenuItem Header="_Stop" Click="Pause_Click"/>
        <MenuItem Header="Stop _all" Click="StopAll_Click"/>
        <Separator/>
        <MenuItem Header="_Scheduler…" Click="Scheduler_Click"/>
        <MenuItem Header="Start the _main download queue" Click="StartMainQueue_Click"/>
        <MenuItem Header="Stop all _queues" Click="StopQueues_Click"/>
        <MenuItem Header="Resume all stopped downloads" Click="StartAll_Click"/>
        <Separator/>
        <MenuItem Header="Re_download" Click="Retry_Click"/>
        <MenuItem Header="_Delete" InputGestureText="Del" Click="Remove_Click"/>
        <MenuItem Header="Delete _completed" Click="DeleteCompleted_Click"/>
        <Separator/>
        <MenuItem Header="Raise priority" Click="PriorityUp_Click"/>
        <MenuItem Header="Lower priority" Click="PriorityDown_Click"/>
        <Separator/>
        <MenuItem Header="_Options…" Click="Settings_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ShowCategories" Header="_Categories panel" IsCheckable="True" IsChecked="True" Click="ToggleCategories_Click"/>
        <MenuItem Header="Download _history…" Click="History_Click"/>
        <Separator/>
        <MenuItem Header="Intelligent _Center" Click="Center_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Getting started" Click="GettingStarted_Click"/>
        <MenuItem Header="_About Epsilon Download Manager" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <!-- product identity -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,11">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentDark}" Margin="0,0,11,0">
            <TextBlock Text="E" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="EPSILON DOWNLOAD MANAGER" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
            <TextBlock Text="Fast, intelligent and private downloading" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <!-- live status: what these say is checked, not decoration -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource StatusPill}">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="SmartDot" Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="SmartText" Text="SMART ENGINE ON" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatusPill}" Margin="0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="BrowserDot" Width="7" Height="7" Fill="{DynamicResource Warning}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="BrowserText" Text="BROWSER NOT CONNECTED" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
        <Border DockPanel.Dock="Right" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="8,0" VerticalAlignment="Center" Margin="8,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            <TextBox x:Name="SearchBox" Width="170" BorderThickness="0" Background="Transparent" Padding="7,7" TextChanged="SearchBox_TextChanged" ToolTip="Search the list"/>
          </StackPanel>
        </Border>
        <WrapPanel Orientation="Horizontal">
          <Button Style="{StaticResource ToolBtn}" Click="Add_Click" ToolTip="Add a download (Ctrl+N)"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" Foreground="{DynamicResource Accent}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Add URL"/></StackPanel></Button>
          <Button Style="{StaticResource ToolBtn}" Click="AddTorrent_Click" ToolTip="Add a magnet link or a .torrent file"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE753;" Foreground="{DynamicResource Success}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Add Torrent"/></StackPanel></Button>
          <Button x:Name="BtnResume" Style="{StaticResource ToolBtn}" Click="Start_Click" ToolTip="Resume the selected downloads"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Resume"/></StackPanel></Button>
          <Button x:Name="BtnStop" Style="{StaticResource ToolBtn}" Click="Pause_Click" ToolTip="Stop the selected downloads"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" Foreground="{DynamicResource IconGrey}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Stop"/></StackPanel></Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnSpeedLimiter" Style="{StaticResource ToolBtn}" Click="SpeedLimiter_Click" ToolTip="Limit the total download speed (like IDM's Speed Limiter)">
            <StackPanel>
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE9E9;" Foreground="{DynamicResource IconAmber}"/>
              <TextBlock x:Name="SpeedLimiterCaption" Style="{StaticResource ToolCaption}" Text="Unlimited"/>
            </StackPanel>
          </Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnDelete" Style="{StaticResource ToolBtn}" Click="Remove_Click" ToolTip="Delete the selected downloads (Del)"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" Foreground="{DynamicResource IconGrey}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Delete"/></StackPanel></Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnMore" Style="{StaticResource ToolBtn}" Click="More_Click" ToolTip="More: stop all, delete completed, queues, scheduler, intelligent center, grabber, theme"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE712;" Foreground="{DynamicResource IconGrey}"/><TextBlock Style="{StaticResource ToolCaption}" Text="More"/></StackPanel></Button>
          <Button Style="{StaticResource ToolBtn}" Click="Settings_Click" ToolTip="Settings"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" Foreground="{DynamicResource IconGrey}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Options"/></StackPanel></Button>
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- Speed Limiter popup (IDM-style): quick presets plus a custom KB/s value, applied at once to every download -->
    <Popup x:Name="SpeedLimiterPopup" PlacementTarget="{Binding ElementName=BtnSpeedLimiter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14" Width="270">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="Black"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Speed Limiter" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
          <TextBlock Text="Caps the speed of ordinary downloads. Torrents have their own limits in Options &gt; BitTorrent." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>

          <CheckBox x:Name="SpeedLimiterToggle" Content="Limit enabled" Click="SpeedLimiterToggle_Click" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Slider x:Name="SpeedLimiterSlider" Grid.Column="0" Minimum="0" Maximum="10240" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="SpeedLimiterSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="SpeedLimiterBox" Width="64" TextAlignment="Right" TextChanged="SpeedLimiterBox_TextChanged"/>
              <TextBlock Text="KB/s" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="Quick presets" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
          <WrapPanel x:Name="SpeedLimiterPresets" Margin="0,0,0,4"/>

          <TextBlock x:Name="SpeedLimiterTorrentNote" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- toolbar's "More" overflow: the less-frequently-used actions, kept out of the main row -->
    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=BtnMore}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="6" Width="240">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="Black"/>
        </Border.Effect>
        <StackPanel>
          <Button x:Name="BtnStopAll" Style="{StaticResource ToolMenuRow}" Click="StopAll_Click" ToolTip="Stop every running download"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" FontSize="16" Foreground="{DynamicResource Danger}" Margin="0,0,10,0"/><TextBlock Text="Stop All" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button x:Name="BtnDeleteCompleted" Style="{StaticResource ToolMenuRow}" Click="DeleteCompleted_Click" ToolTip="Remove all finished downloads from the list"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE73E;" FontSize="16" Foreground="{DynamicResource Success}" Margin="0,0,10,0"/><TextBlock Text="Delete Completed" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <Button x:Name="BtnStartAll" Style="{StaticResource ToolMenuRow}" Click="StartQueue_Click" ToolTip="Start a queue (you choose which)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;" FontSize="16" Foreground="{DynamicResource Success}" Margin="0,0,10,0"/><TextBlock Text="Start Queue" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button x:Name="BtnStopQueue" Style="{StaticResource ToolMenuRow}" Click="StopQueue_Click" ToolTip="Stop a running queue"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE769;" FontSize="16" Foreground="{DynamicResource Warning}" Margin="0,0,10,0"/><TextBlock Text="Stop Queue" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="Scheduler_Click" ToolTip="Queues, start/stop times, shut down when done"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE787;" FontSize="16" Foreground="{DynamicResource IconPurple}" Margin="0,0,10,0"/><TextBlock Text="Scheduler" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="Center_Click" ToolTip="Server learning, bandwidth profiles, health checks, backup and more"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7B8;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Intelligent Center" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <Button Style="{StaticResource ToolMenuRow}" Click="SiteGrabber_Click" ToolTip="Grab the links of a web page"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE774;" FontSize="16" Foreground="{DynamicResource IconTeal}" Margin="0,0,10,0"/><TextBlock Text="Grabber" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <TextBlock Text="Theme" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,4,0,2"/>
          <Button x:Name="ThemeLightRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="light"><Grid><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE708;" FontSize="16" Foreground="{DynamicResource IconGrey}" Margin="0,0,10,0"/><TextBlock Text="Light" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock x:Name="ThemeLightCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeDarkRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="dark"><Grid><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE706;" FontSize="16" Foreground="{DynamicResource IconGrey}" Margin="0,0,10,0"/><TextBlock Text="Dark" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock x:Name="ThemeDarkCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeOrangeRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="orange"><Grid><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#D6690A" Margin="0,0,10,0"/><TextBlock Text="Orange" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock x:Name="ThemeOrangeCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeEpsilonRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="epsilon"><Grid><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#13C8F5" Margin="0,0,10,0"/><TextBlock Text="Epsilon" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock x:Name="ThemeEpsilonCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
        </StackPanel>
      </Border>
    </Popup>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock x:Name="ActiveText" Margin="0,0,18,0" Foreground="{DynamicResource Muted}" Text="0 active"/>
          <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,1,6,0"/>
          <TextBlock x:Name="TotalSpeed" MinWidth="86" FontWeight="SemiBold" Text="0 B/s"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="Footer" Foreground="{DynamicResource Muted}" Text="Ready" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- categories + list -->
    <Grid Margin="10,10,10,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="CategoryColumn" Width="220"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="CategoryPanel" Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="LIBRARY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="14,12,14,4"/>
          <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" Margin="4,0,4,6" SelectedItemChanged="Tree_SelectedItemChanged"/>
        </DockPanel>
      </Border>
      <GridSplitter x:Name="Splitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>

      <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10">
        <ListView x:Name="Downloads" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Margin="1"
                  ItemContainerStyle="{StaticResource RowStyle}" SelectionChanged="Downloads_SelectionChanged" MouseDoubleClick="Downloads_DoubleClick" ContextMenuOpening="Downloads_ContextMenuOpening">
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="Open_Click"/>
              <MenuItem x:Name="PlayPartialMenuItem" Header="Play (downloaded part)" Click="PlayPartial_Click" Tag="play"/>
              <MenuItem x:Name="ForceDownloadMenuItem" Header="Force Download" IsCheckable="True" Click="ForceDownload_Click" ToolTip="Ignore the download/seed schedule for this torrent and keep it running" Tag="force"/>
              <MenuItem Header="Open folder" Click="OpenFolder_Click"/>
              <Separator/>
              <MenuItem Header="Resume" Click="Start_Click"/>
              <MenuItem Header="Stop" Click="Pause_Click"/>
              <MenuItem Header="Redownload" Click="Retry_Click"/>
              <Separator/>
              <MenuItem Header="Raise priority" Click="PriorityUp_Click"/>
              <MenuItem Header="Lower priority" Click="PriorityDown_Click"/>
              <MenuItem Header="Copy address" Click="CopyUrl_Click"/>
              <MenuItem Header="Add to queue" Tag="queue"/>
              <Separator/>
              <MenuItem Header="Delete" Click="Remove_Click"/>
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="DOWNLOAD" Width="330">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FilePath}"/>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Queue" Width="90" DisplayMemberBinding="{Binding QueueMark}"/>
              <GridViewColumn Header="SIZE" Width="92" DisplayMemberBinding="{Binding SizeDisplay}"/>
              <GridViewColumn Header="STATUS" Width="150">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Width="126" VerticalAlignment="Center">
                      <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="12"/>
                      <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="4" Margin="0,4,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Queued"><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Complete"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="TIME LEFT" Width="80" DisplayMemberBinding="{Binding TimeLeft}"/>
              <GridViewColumn Header="SPEED" Width="100" DisplayMemberBinding="{Binding Rate}"/>
              <GridViewColumn Header="UP SPEED" Width="90" DisplayMemberBinding="{Binding UpSpeedText}"/>
              <GridViewColumn Header="SEEDS (PEERS)" Width="100" DisplayMemberBinding="{Binding PeersText}"/>
              <GridViewColumn Header="LAST TRY" Width="130" DisplayMemberBinding="{Binding LastTry}"/>
              <GridViewColumn Header="DESCRIPTION" Width="320" DisplayMemberBinding="{Binding Description}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
    </Grid>
  </DockPanel>
</Window>
