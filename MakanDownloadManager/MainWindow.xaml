<Window x:Class="MakanDownloadManager.MainWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epsilon Download Manager" Width="1240" Height="740" MinWidth="920" MinHeight="500" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <!-- v1.6 command button: compact, horizontal and deliberately unlike an IDM ribbon -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,7">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="7,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="5,4"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- Canvas navigation is text-first: a thin accent line replaces boxed tabs. -->
    <Style x:Key="CanvasTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,26,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,9,2,8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a row in the toolbar's "More" overflow popup: icon on the left, full-width label, left-aligned -->
    <Style x:Key="ToolMenuRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- list rows: roomy download cards -->
    <Style x:Key="RowStyle" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,8"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Canvas header: one quiet workspace, no permanent navigation rail or ribbon. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,14,18,0">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Downloads" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <TextBlock x:Name="CanvasSummary" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Padding="10,0" VerticalAlignment="Center" MinWidth="120" MaxWidth="360" HorizontalAlignment="Stretch">
            <DockPanel>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
              <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="9,7" TextChanged="SearchBox_TextChanged" ToolTip="Search downloads by name or URL"/>
            </DockPanel>
          </Border>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource ToolBtn}" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Click="Add_Click" ToolTip="Add a download (Ctrl+N)">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" Foreground="{DynamicResource OnAccent}"/><TextBlock Style="{StaticResource ToolCaption}" Foreground="{DynamicResource OnAccent}" Text="New download"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Click="AddTorrent_Click" ToolTip="Add a magnet link or a .torrent file">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE753;" Foreground="{DynamicResource IconGrey}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Torrent"/></StackPanel>
            </Button>
            <Button x:Name="BtnStartAllTop" Style="{StaticResource ToolBtn}" Click="StartAll_Click" ToolTip="Resume all stopped downloads">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;"/><TextBlock Style="{StaticResource ToolCaption}" Text="Start all"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Click="Scheduler_Click" ToolTip="Open download schedules and queues">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE787;"/><TextBlock Style="{StaticResource ToolCaption}" Text="Schedule"/></StackPanel>
            </Button>
            <Button x:Name="BtnSpeedLimiter" Style="{StaticResource ToolBtn}" Click="SpeedLimiter_Click" ToolTip="Set the download speed limit">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                  <Canvas Width="20" Height="20">
                    <Path Data="M 2,15 A 8,8 0 0 1 18,15" Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="10" Y1="15" X2="14.5" Y2="7.5" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="4" Y1="11" X2="5.5" Y2="11.8" Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
                    <Line X1="10" Y1="7" X2="10" Y2="9" Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
                    <Line X1="16" Y1="11" X2="14.5" Y2="11.8" Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
                  </Canvas>
                </Viewbox>
                <TextBlock x:Name="SpeedLimiterCaption" Style="{StaticResource ToolCaption}" Text="Unlimited"/>
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource Muted}" Margin="6,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnMore" Style="{StaticResource ToolBtn}" Click="More_Click" ToolTip="More options &amp; tools" Padding="11,7">
              <TextBlock Text="•••" FontSize="15" Foreground="{DynamicResource Text}" Margin="0,-3,0,3"/>
            </Button>
            <!-- Selection-only actions stay available in the row context menu and keyboard shortcuts. -->
            <Button x:Name="BtnResume" Visibility="Collapsed"/><Button x:Name="BtnStop" Visibility="Collapsed"/><Button x:Name="BtnStopAllTop" Visibility="Collapsed"/>
            <StackPanel Visibility="Collapsed"><Border x:Name="SmartDot"/><TextBlock x:Name="SmartText"/><Border x:Name="BrowserDot"/><TextBlock x:Name="BrowserText"/><TextBlock x:Name="MultiNetCaption"/><TextBlock x:Name="MultiNetGlyph"/></StackPanel>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <RadioButton x:Name="FilterAll" Style="{StaticResource CanvasTab}" Content="All" Tag="all" GroupName="CanvasFilter" IsChecked="True" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterActive" Style="{StaticResource CanvasTab}" Content="Active" Tag="unfinished" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterFinished" Style="{StaticResource CanvasTab}" Content="Finished" Tag="finished" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterQueues" Style="{StaticResource CanvasTab}" Content="Queues" Tag="queues" GroupName="CanvasFilter" Click="FilterTab_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- quick speed control; detailed connection settings remain available in Options -->
    <Popup x:Name="SpeedLimiterPopup" PlacementTarget="{Binding ElementName=BtnSpeedLimiter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="16" Width="310">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="Speed limiter" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
          <TextBlock x:Name="SpeedLimiterStatus" Margin="0,4,0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
          <TextBlock Text="Custom limit" FontSize="11" Foreground="{DynamicResource Muted}"/>
          <DockPanel Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Right" Text="KB/s" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            <TextBox x:Name="SpeedLimiterRateBox" Text="1024" Padding="8,6"/>
          </DockPanel>
          <ComboBox x:Name="SpeedLimiterScopeBox" SelectedIndex="0" Padding="6" Margin="0,0,0,10">
            <ComboBoxItem Content="All downloads combined"/>
            <ComboBoxItem Content="Each download"/>
          </ComboBox>
          <TextBlock Text="Quick limits" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
          <UniformGrid Columns="3" Margin="0,0,0,12">
            <Button Content="300 KB/s" Tag="300" Click="SpeedLimiterPreset_Click" Margin="0,0,4,0" Padding="5"/>
            <Button Content="1 MB/s" Tag="1024" Click="SpeedLimiterPreset_Click" Margin="2,0" Padding="5"/>
            <Button Content="5 MB/s" Tag="5120" Click="SpeedLimiterPreset_Click" Margin="4,0,0,0" Padding="5"/>
          </UniformGrid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Unlimited" Click="SpeedLimiterUnlimited_Click" Padding="7" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="Cancel" Click="SpeedLimiterCancel_Click" Padding="7" Margin="2,0"/>
            <Button Grid.Column="2" Content="Apply" Click="SpeedLimiterApply_Click" Padding="7" Margin="4,0,0,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <!-- "More" overflow popup -->
    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=BtnMore}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8" Width="270">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Button Style="{StaticResource ToolMenuRow}" Click="AddBatch_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Add batch download…" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SiteGrabber_Click" ToolTip="Grab web page links"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE774;" FontSize="16" Foreground="{DynamicResource IconTeal}" Margin="0,0,10,0"/><TextBlock Text="Site grabber" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="Center_Click" ToolTip="Server learning &amp; health checks"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7B8;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Intelligent Center" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="AppMenu_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Newest first" Tag="Id:Descending" Click="Sort_Click"/>
                <MenuItem Header="Oldest first" Tag="Id:Ascending" Click="Sort_Click"/>
                <Separator/>
                <MenuItem Header="Name (A–Z)" Tag="FileName:Ascending" Click="Sort_Click"/>
                <MenuItem Header="Name (Z–A)" Tag="FileName:Descending" Click="Sort_Click"/>
                <MenuItem Header="Size (largest first)" Tag="TotalBytes:Descending" Click="Sort_Click"/>
                <MenuItem Header="Size (smallest first)" Tag="TotalBytes:Ascending" Click="Sort_Click"/>
                <MenuItem Header="Status" Tag="Status:Ascending" Click="Sort_Click"/>
                <MenuItem Header="Progress" Tag="Progress:Descending" Click="Sort_Click"/>
                <MenuItem Header="Speed" Tag="SpeedBytesPerSec:Descending" Click="Sort_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8CB;" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock Text="Sort downloads" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="History_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE81C;" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock Text="Download history…" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock Text="Settings" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <Button x:Name="BtnDelete" Style="{StaticResource ToolMenuRow}" Click="Remove_Click" ToolTip="Delete selected downloads (Del)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" FontSize="16" Foreground="{DynamicResource Danger}" Margin="0,0,10,0"/><TextBlock Text="Delete selected" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button x:Name="BtnStopAll" Style="{StaticResource ToolMenuRow}" Click="StopAll_Click" ToolTip="Stop every running download"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" FontSize="16" Foreground="{DynamicResource Danger}" Margin="0,0,10,0"/><TextBlock Text="Stop All" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button x:Name="BtnDeleteCompleted" Style="{StaticResource ToolMenuRow}" Click="DeleteCompleted_Click" ToolTip="Remove finished downloads from the list"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE73E;" FontSize="16" Foreground="{DynamicResource Success}" Margin="0,0,10,0"/><TextBlock Text="Delete Completed" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <CheckBox x:Name="ShowCategories" Content="Show navigation panel" IsChecked="False" Click="ToggleCategories_Click" Margin="10,7"/>
          <CheckBox x:Name="ShowDropTarget" Content="Show drop target" Click="ShowDropTarget_Click" Margin="10,7"/>
          <Button Style="{StaticResource ToolMenuRow}" Click="AppMenu_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add batch from clipboard" InputGestureText="Ctrl+V" Click="BatchClipboard_Click"/>
                <Separator/>
                <MenuItem Header="Open selected" InputGestureText="Enter" Click="Open_Click"/>
                <MenuItem Header="Open folder" Click="OpenFolder_Click"/>
                <MenuItem Header="Copy address" Click="CopyUrl_Click"/>
                <Separator/>
                <MenuItem Header="Start main queue" Click="StartMainQueue_Click"/>
                <MenuItem Header="Stop all queues" Click="StopQueues_Click"/>
                <Separator/>
                <MenuItem Header="Import from text file…" Click="ImportText_Click"/>
                <MenuItem Header="Export to text file…" Click="ExportText_Click"/>
                <MenuItem Header="Export diagnostic report…" Click="Diagnostics_Click"/>
                <Separator/>
                <MenuItem Header="Getting started" Click="GettingStarted_Click"/>
                <MenuItem Header="About Epsilon" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE700;" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock Text="All commands" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel>
          </Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <TextBlock Text="Theme" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,4,0,2"/>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="obsidian-gold"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#E0B75A" Margin="0,0,10,0"/><TextBlock Text="Obsidian Gold" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeObsidianGoldCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="platinum-blue"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#1467D8" Margin="0,0,10,0"/><TextBlock Text="Platinum Blue" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemePlatinumBlueCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="royal-amethyst"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#A873F0" Margin="0,0,10,0"/><TextBlock Text="Royal Amethyst" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeRoyalAmethystCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="emerald-executive"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#45D8AE" Margin="0,0,10,0"/><TextBlock Text="Emerald Executive" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeEmeraldExecutiveCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="champagne-minimal"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#9B682D" Margin="0,0,10,0"/><TextBlock Text="Champagne Minimal" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeChampagneMinimalCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="graphite-copper"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#E28A4D" Margin="0,0,10,0"/><TextBlock Text="Graphite Copper" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeGraphiteCopperCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="sapphire-noir"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#2E86FF" Margin="0,0,10,0"/><TextBlock Text="Sapphire Noir" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeSapphireNoirCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="ivory-luxe"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#93642D" Margin="0,0,10,0"/><TextBlock Text="Ivory Luxe" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeIvoryLuxeCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="rose-titanium"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#E187B1" Margin="0,0,10,0"/><TextBlock Text="Rose Titanium" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeRoseTitaniumCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="arctic-glass"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#087AB8" Margin="0,0,10,0"/><TextBlock Text="Arctic Glass" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeArcticGlassCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="dracula"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#BD93F9" Margin="0,0,10,0"/><TextBlock Text="Dracula" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeDraculaCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="makan-lab"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#58A6FF" Margin="0,0,10,0"/><TextBlock Text="Makan Lab" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeMakanLabCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Footer" Foreground="{DynamicResource Muted}" Text="Ready" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="ActiveText" Grid.Column="1" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
        <TextBlock x:Name="TotalSpeed" Grid.Column="2" HorizontalAlignment="Right" MinWidth="90" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="0 B/s" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- categories + list -->
    <Grid Margin="16,10,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="CategoryColumn" Width="0"/>
        <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Category Panel -->
      <Border x:Name="CategoryPanel" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4">
        <DockPanel Margin="6,10">
          <TextBlock DockPanel.Dock="Top" Text="LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="12,4,12,8"/>
          <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" SelectedItemChanged="Tree_SelectedItemChanged"/>
        </DockPanel>
      </Border>
      
      <GridSplitter x:Name="Splitter" Grid.Column="1" Visibility="Collapsed" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>

      <!-- Downloads List -->
      <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0" CornerRadius="0">
        <Grid>
        <ListView x:Name="Downloads" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Margin="0"
                  ItemContainerStyle="{StaticResource RowStyle}" SelectionChanged="Downloads_SelectionChanged" MouseDoubleClick="Downloads_DoubleClick" ContextMenuOpening="Downloads_ContextMenuOpening"
                  PreviewMouseDown="Downloads_PreviewMouseDown" PreviewMouseLeftButtonDown="Downloads_PreviewMouseLeftButtonDown" PreviewMouseMove="Downloads_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="Downloads_PreviewMouseLeftButtonUp" LostMouseCapture="Downloads_LostMouseCapture">
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="Open_Click"/>
              <MenuItem x:Name="PlayPartialMenuItem" Header="Play (downloaded part)" Click="PlayPartial_Click" Tag="play"/>
              <MenuItem x:Name="ForceDownloadMenuItem" Header="Force Download" IsCheckable="True" Click="ForceDownload_Click" ToolTip="Ignore schedule for this torrent" Tag="force"/>
              <MenuItem Header="Open folder" Click="OpenFolder_Click"/>
              <Separator/>
              <MenuItem Header="Resume" Click="Start_Click"/>
              <MenuItem Header="Stop" Click="Pause_Click"/>
              <MenuItem Header="Redownload" Click="Retry_Click"/>
              <Separator/>
              <MenuItem Header="Raise priority" Click="PriorityUp_Click"/>
              <MenuItem Header="Lower priority" Click="PriorityDown_Click"/>
              <MenuItem Header="Copy address" Click="CopyUrl_Click"/>
              <MenuItem Header="Add to queue" Tag="queue"/>
              <Separator/>
              <MenuItem Header="Delete" Click="Remove_Click"/>
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="DOWNLOAD" Width="340">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,3">
                      <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="QUEUE" Width="95">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Border Visibility="{Binding QueueMark, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}" CornerRadius="3" Padding="8,2" Background="{DynamicResource Surface}">
                      <TextBlock Text="{Binding QueueMark}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource IconPurple}"/>
                    </Border>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="SIZE" Width="110">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding SizeDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="STATUS &amp; PROGRESS" Width="170">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Width="150" VerticalAlignment="Center">
                      <DockPanel>
                        <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:0}%'}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}"/>
                      </DockPanel>
                      <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,4,0,0" Visibility="Collapsed"
                                   Foreground="{StaticResource BrandGrad}" Background="{DynamicResource Track}" BorderThickness="0"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter TargetName="Bar" Property="Visibility" Value="Visible"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource AccentDark}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Queued"><Setter TargetName="Bar" Property="Visibility" Value="Visible"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource IconPurple}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Complete"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="ETA" Width="85">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding TimeLeft}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="SPEED" Width="110">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Rate}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="UP SPEED" Width="95">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding UpSpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="PEERS" Width="100">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding PeersText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource IconTeal}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="LAST TRY" Width="130">
                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LastTry}" Foreground="{DynamicResource Text}"/></DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="DESCRIPTION" Width="300">
                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
          <Canvas x:Name="SelectionCanvas" Margin="0" IsHitTestVisible="False" Panel.ZIndex="10">
            <Border x:Name="SelectionRectangle" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="1" Opacity="0.62"/>
          </Canvas>
        </Grid>
      </Border>
    </Grid>

    <!-- Delete choices are attached to the selected row instead of occupying a permanent toolbar. -->
    <Popup x:Name="DeleteActionPopup" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="12" Width="760">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.42" Color="Black"/></Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock x:Name="DeleteBarTitle" Text="Remove selected downloads?" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
            <TextBlock Text="Completed files stay on disk." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Remove from Epsilon" Click="DeleteBarRemove_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button x:Name="DeleteUnfinishedDataButton" Content="Delete unfinished data" Click="DeleteBarDisk_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Cancel" Click="DeleteBarCancel_Click" Padding="10,6"/>
          </StackPanel>
        </Grid>
      </Border>
    </Popup>
  </DockPanel>
</Window>
