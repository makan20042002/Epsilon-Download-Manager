    <!-- All built-in themes in one dedicated gallery.  The toolbar button opens this directly; themes are
         deliberately kept out of a generic overflow menu so the complete collection is always visible. -->
    <!-- Themes: one panel under the toolbar, as wide as the window, with every theme as a card (owner's design). -->
    <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=HeaderShell}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
           Width="{Binding ActualWidth, ElementName=HeaderShell}">
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,14,16,16" Margin="0,0,0,18">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.16" Color="Black"/></Border.Effect>
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="✕" Click="ThemeClose_Click" ToolTip="Close" Style="{StaticResource ToolMenuRow}" Padding="8,3" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel><TextBlock Text="Themes" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock x:Name="CurrentThemeText" Text="Applied instantly across the app and extension" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
          </DockPanel>
          <UniformGrid x:Name="ThemeCards" Columns="6"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- "More" overflow popup -->
    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=BtnMore}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8" Width="270">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Button Style="{StaticResource ToolMenuRow}" Click="AddTorrent_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8B7;" FontSize="16" Foreground="{DynamicResource IconPurple}" Margin="0,0,10,0"/><TextBlock Text="Add torrent or magnet…" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="Clipboard_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE77F;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Add clipboard URL" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="AddBatch_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Add batch download…" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SiteGrabber_Click" ToolTip="Grab web page links"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE774;" FontSize="16" Foreground="{DynamicResource IconTeal}" Margin="0,0,10,0"/><TextBlock Text="Site grabber" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="Center_Click" ToolTip="Server learning &amp; health checks"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7B8;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Intelligent Center" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SpeedTest_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE9D9;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Network speed test…" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="AppMenu_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Newest first" Tag="Id:Descending" Click="Sort_Click"/>
                <MenuItem Header="Oldest first" Tag="Id:Ascending" Click="Sort_Click"/>
                <Separator/>
                <MenuItem Header="Name (A–Z)" Tag="FileName:Ascending" Click="Sort_Click"/>
                <MenuItem Header="Name (Z–A)" Tag="FileName:Descending" Click="Sort_Click"/>
                <MenuItem Header="Size (largest first)" Tag="TotalBytes:Descending" Click="Sort_Click"/>
                <MenuItem Header="Size (smallest first)" Tag="TotalBytes:Ascending" Click="Sort_Click"/>
                <MenuItem Header="Status" Tag="Status:Ascending" Click="Sort_Click"/>
                <MenuItem Header="Progress" Tag="Progress:Descending" Click="Sort_Click"/>
                <MenuItem Header="Speed" Tag="SpeedBytesPerSec:Descending" Click="Sort_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8CB;" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock Text="Sort downloads" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="History_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE81C;" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock Text="Download history…" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock Text="Settings" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <Button Style="{StaticResource ToolMenuRow}" Click="Remove_Click" ToolTip="Delete selected downloads (Del)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" FontSize="16" Foreground="{DynamicResource Danger}" Margin="0,0,10,0"/><TextBlock Text="Delete selected" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button x:Name="BtnStopAll" Style="{StaticResource ToolMenuRow}" Click="StopAll_Click" ToolTip="Stop every running download"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" FontSize="16" Foreground="{DynamicResource Danger}" Margin="0,0,10,0"/><TextBlock Text="Stop All" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="DeleteCompleted_Click" ToolTip="Remove finished downloads from the list"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE73E;" FontSize="16" Foreground="{DynamicResource Success}" Margin="0,0,10,0"/><TextBlock Text="Delete Completed" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <CheckBox x:Name="ShowCategories" Content="Show legacy category tree" IsChecked="False" Click="ToggleCategories_Click" Margin="10,7" Visibility="Collapsed"/>
          <CheckBox x:Name="ShowDropTarget" Content="Show drop target" Click="ShowDropTarget_Click" Margin="10,7"/>
          <Button Style="{StaticResource ToolMenuRow}" Click="AppMenu_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add batch from clipboard" InputGestureText="Ctrl+V" Click="BatchClipboard_Click"/>
                <Separator/>
                <MenuItem Header="Open selected" InputGestureText="Enter" Click="Open_Click"/>
                <MenuItem Header="Open folder" Click="OpenFolder_Click"/>
                <MenuItem Header="Copy address" Click="CopyUrl_Click"/>
                <Separator/>
                <MenuItem Header="Start main queue" Click="StartMainQueue_Click"/>
                <MenuItem Header="Stop all queues" Click="StopQueues_Click"/>
                <Separator/>
                <MenuItem Header="Import from text file…" Click="ImportText_Click"/>
                <MenuItem Header="Export to text file…" Click="ExportText_Click"/>
                <MenuItem Header="Export diagnostic report…" Click="Diagnostics_Click"/>
                <Separator/>
                <MenuItem Header="Getting started" Click="GettingStarted_Click"/>
                <MenuItem Header="Report a bug…" Click="ReportBug_Click"/>
                <MenuItem Header="About Epsilon" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE700;" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock Text="All commands" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel>
          </Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <Button Style="{StaticResource ToolMenuRow}" Click="Themes_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Themes…" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,9">
      <DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Disk free " Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FooterDisk" Text="—" FontWeight="SemiBold" Margin="0,0,6,0"/><StackPanel Visibility="Collapsed"><TextBlock x:Name="FooterMultiNet"/><TextBlock x:Name="FooterLimiter"/><TextBlock x:Name="FooterBrowser"/></StackPanel></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0"><TextBlock x:Name="TotalSpeed" MinWidth="90" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="↓ 0 B/s" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/><TextBlock x:Name="ActiveText" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="30,0,0,0"/></StackPanel><Ellipse Width="10" Height="10" Fill="{DynamicResource Success}" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="Footer" Foreground="{DynamicResource Muted}" Text="Ready" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
    </Border>

    <!-- v6 delete prompt: the file is never erased unless the user explicitly chooses a disk action. -->
    <Popup x:Name="DeleteActionPopup" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="20" Width="540">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.42" Color="Black"/></Border.Effect>
        <StackPanel>
          <DockPanel Margin="0,0,0,14"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource Danger}" Margin="0,0,12,0"/><StackPanel><TextBlock x:Name="DeleteBarTitle" Text="Delete selected download?" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock x:Name="DeleteBarHelp" Text="Choose exactly what Epsilon should remove." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DeleteTorrentNote" Text="Removing a seeding torrent also stops sharing it." FontSize="11" Foreground="{DynamicResource Warning}" Margin="0,5,0,0" Visibility="Collapsed"/></StackPanel></DockPanel>
          <Button Click="DeleteBarRemove_Click" Style="{StaticResource ToolMenuRow}" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Muted}"/><StackPanel Grid.Column="1"><TextBlock Text="Remove from list" FontWeight="SemiBold"/><TextBlock Text="Keep every downloaded file on your disk." FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="R" Foreground="{DynamicResource Muted}"/></Grid></Button>
          <Button x:Name="DeleteFileOnlyButton" Click="DeleteBarFileOnly_Click" Style="{StaticResource ToolMenuRow}" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Warning}"/><StackPanel Grid.Column="1"><TextBlock Text="Delete file only" FontWeight="SemiBold"/><TextBlock Text="Erase its data but keep the entry so it can be downloaded again." FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="F" Foreground="{DynamicResource Muted}"/></Grid></Button>
          <Button x:Name="DeleteUnfinishedDataButton" Click="DeleteBarDisk_Click" Style="{StaticResource ToolMenuRow}" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Danger}"/><StackPanel Grid.Column="1"><TextBlock Text="Delete completely" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/><TextBlock Text="Remove the entry and erase its file from disk. This cannot be undone." FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="D" Foreground="{DynamicResource Muted}"/></Grid></Button>
          <DockPanel Margin="4,14,4,0"><CheckBox x:Name="RememberDeleteChoice" Content="Remember my choice" FontSize="11" Foreground="{DynamicResource Muted}"/><Button DockPanel.Dock="Right" Content="Cancel" Click="DeleteBarCancel_Click" Padding="12,6"/></DockPanel>
        </StackPanel>
      </Border>
    </Popup>

    <!-- categories + list: must stay the LAST child of the DockPanel so it fills the window -->
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="CategoryColumn" Width="0"/>
        <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Category Panel -->
      <Border x:Name="CategoryPanel" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4">
        <DockPanel Margin="6,10">
          <TextBlock DockPanel.Dock="Top" Text="LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="12,4,12,8"/>
          <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" SelectedItemChanged="Tree_SelectedItemChanged"/>
        </DockPanel>
      </Border>
      
      <GridSplitter x:Name="Splitter" Grid.Column="1" Visibility="Collapsed" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>

      <!-- Downloads List -->
      <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="18" Margin="14,0,14,12">
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0" Padding="10,6">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox Content="Select all" Click="SelectAll_Click" VerticalAlignment="Center" Margin="3,0,18,0"/>
            <TextBlock Grid.Column="1" Text="Drag any column edge to resize it · widths are remembered" FontSize="10.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel x:Name="SelectionActions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
              <TextBlock x:Name="SelectedCountText" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button Content="Resume" Click="Start_Click" Padding="8,3" Margin="2,0"/>
              <Button Content="Stop" Click="Pause_Click" Padding="8,3" Margin="2,0"/>
              <Button Content="Move to queue ▾" Click="MoveSelectedQueue_Click" Padding="8,3" Margin="2,0"/>
              <Button Content="Delete…" Click="Remove_Click" Padding="8,3" Margin="2,0" Foreground="{DynamicResource Danger}"/>
            </StackPanel>
          </Grid>
        </Border>
        <ListView Grid.Row="1" x:Name="Downloads" FontSize="12" SelectionMode="Extended" AlternationCount="2147483647" Background="Transparent" BorderThickness="0" Margin="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                  ItemContainerStyle="{StaticResource RowStyle}" SelectionChanged="Downloads_SelectionChanged" MouseDoubleClick="Downloads_DoubleClick" ContextMenuOpening="Downloads_ContextMenuOpening"
                  PreviewMouseDown="Downloads_PreviewMouseDown" PreviewMouseLeftButtonDown="Downloads_PreviewMouseLeftButtonDown" PreviewMouseMove="Downloads_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="Downloads_PreviewMouseLeftButtonUp" LostMouseCapture="Downloads_LostMouseCapture">
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="Open_Click"/>
              <MenuItem x:Name="PlayPartialMenuItem" Header="Play (downloaded part)" Click="PlayPartial_Click" Tag="play"/>
              <MenuItem x:Name="ForceDownloadMenuItem" Header="Force Download" IsCheckable="True" Click="ForceDownload_Click" ToolTip="Ignore schedule for this torrent" Tag="force"/>
              <MenuItem Header="Open folder" Click="OpenFolder_Click"/>
              <Separator/>
              <MenuItem Header="Resume" Click="Start_Click"/>
              <MenuItem Header="Stop" Click="Pause_Click"/>
              <MenuItem Header="Redownload" Click="Retry_Click"/>
              <Separator/>
              <MenuItem Header="Raise priority" Click="PriorityUp_Click"/>
              <MenuItem Header="Lower priority" Click="PriorityDown_Click"/>
              <MenuItem Header="Copy address" Click="CopyUrl_Click"/>
              <MenuItem Header="Add to queue" Tag="queue"/>
              <Separator/>
              <MenuItem Header="Delete" Click="Remove_Click"/>
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.View>
            <GridView AllowsColumnReorder="True">
              <GridViewColumn x:Name="GridIndexColumn" Width="42"><GridViewColumn.Header><GridViewColumnHeader Foreground="{DynamicResource Faint}">#</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndexConverter}}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridNameColumn" Width="230">
                <GridViewColumn.Header><GridViewColumnHeader Tag="FileName" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged" Foreground="{DynamicResource Accent}">NAME</GridViewColumnHeader></GridViewColumn.Header>
                <GridViewColumn.CellTemplate><DataTemplate><Grid Margin="2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="FileIcon" Width="28" Height="28" CornerRadius="8" Background="{Binding TileColor}" VerticalAlignment="Center"><TextBlock x:Name="FileGlyph" Text="{Binding TileGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/><TextBlock x:Name="GridDescription" Text="{Binding Description}" FontSize="9.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></Grid></DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn x:Name="GridTypeColumn" Width="64"><GridViewColumn.Header><GridViewColumnHeader Tag="TypeKind" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">TYPE</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><Border Background="{DynamicResource Selected}" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left"><TextBlock Text="{Binding TypeBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource IconPurple}" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridSizeColumn" Width="76"><GridViewColumn.Header><GridViewColumnHeader Tag="TotalBytes" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">SIZE</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeDisplay}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridProgressColumn" Width="150"><GridViewColumn.Header><GridViewColumnHeader Tag="Progress" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">PROGRESS</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><Grid><local:SegmentBar Height="16" VerticalAlignment="Center" Item="{Binding}" Progress="{Binding Progress}" Status="{Binding Status}" Fill="{DynamicResource Accent}" Track="{DynamicResource BarTrack}" DoneFill="{DynamicResource Success}" TorrentFill="{DynamicResource IconPurple}"/><TextBlock Text="{Binding Progress, StringFormat='{}{0:0.0}%'}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Progress, Converter={x:Static local:ProgressTextBrush.Instance}}"/></Grid></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridSpeedColumn" Width="86"><GridViewColumn.Header><GridViewColumnHeader Tag="SpeedBytesPerSec" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">SPEED</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Rate}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Success}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridConnectionsColumn" Width="210"><GridViewColumn.Header><GridViewColumnHeader Tag="ActiveConnections" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">CONNECTIONS</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ConnectionsDisplay}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource IconTeal}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridNetworkColumn" Width="72"><GridViewColumn.Header><GridViewColumnHeader Tag="NetworkDisplay" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">NETWORK</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#2E86E8" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#1E9E5A" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Complete"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding NetworkDisplay}" FontSize="10.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridStatusColumn" Width="100"><GridViewColumn.Header><GridViewColumnHeader Tag="Status" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">STATUS</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#14808080"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Background" Value="#2229B36B"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Complete"><Setter Property="Background" Value="#2229B36B"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Queued"><Setter Property="Background" Value="#33F0A030"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Background" Value="#33F0A030"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Background" Value="#33E5484D"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE915;"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Text" Value="&#xE896;"/><Setter Property="Foreground" Value="#1E9E5A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Complete"><Setter Property="Text" Value="&#xE930;"/><Setter Property="Foreground" Value="#1E9E5A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Queued"><Setter Property="Text" Value="&#xE916;"/><Setter Property="Foreground" Value="#E08B3E"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Text" Value="&#xE769;"/><Setter Property="Foreground" Value="#E08B3E"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Text" Value="&#xE783;"/><Setter Property="Foreground" Value="#E5484D"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock x:Name="GridStatusText" Text="{Binding RowStatusText}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel.Resources><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Queued"><Setter Property="Foreground" Value="{DynamicResource IconPurple}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Complete"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></StackPanel.Resources></StackPanel></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridTimeColumn" Width="70"><GridViewColumn.Header><GridViewColumnHeader Tag="TimeLeft" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">ETA</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TimeLeft, TargetNullValue=—}" Foreground="{DynamicResource Muted}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridDateColumn" Width="126"><GridViewColumn.Header><GridViewColumnHeader Tag="CreatedAt" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">DATE ADDED</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DateAddedDisplay}" Foreground="{DynamicResource Muted}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridMenuColumn" Width="44"><GridViewColumn.Header><GridViewColumnHeader IsHitTestVisible="False"></GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><Button Content="&#xE712;" FontFamily="{StaticResource IconFont}" Click="RowMenu_Click" Background="Transparent" BorderThickness="0" Padding="8,2" ToolTip="More actions"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridQueueColumn" Width="92"><GridViewColumn.Header><GridViewColumnHeader Tag="QueueName" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">QUEUE</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><Border x:Name="QB" BorderBrush="{DynamicResource IconPurple}" BorderThickness="1" CornerRadius="8" Padding="8,2"><TextBlock x:Name="QT" Text="{Binding QueueMark, TargetNullValue=—}" Foreground="{DynamicResource IconPurple}" TextTrimming="CharacterEllipsis"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding QueueName}" Value="{x:Null}"><Setter TargetName="QB" Property="BorderBrush" Value="Transparent"/><Setter TargetName="QT" Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridDownloadedColumn" Width="116"><GridViewColumn.Header><GridViewColumnHeader Tag="DoneBytes" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">DOWNLOADED</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DownloadedDisplay}" FontFamily="{StaticResource MonoFont}" Foreground="#2E86E8"/><TextBlock Text="{Binding Progress, StringFormat='{}{0:0}%'}" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridRemainingColumn" Width="110"><GridViewColumn.Header><GridViewColumnHeader Tag="RemainingDisplay" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">REMAINING</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RemainingDisplay}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Warning}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>

              <GridViewColumn x:Name="GridFinishedColumn" Width="126"><GridViewColumn.Header><GridViewColumnHeader Tag="FinishedAt" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">FINISHED</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FinishedDisplay, TargetNullValue=—}" Foreground="{DynamicResource Muted}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn x:Name="GridAverageColumn" Width="112"><GridViewColumn.Header><GridViewColumnHeader Tag="AverageSpeedText" Click="GridHeader_Click" SizeChanged="GridHeader_SizeChanged">AVERAGE</GridViewColumnHeader></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AverageSpeedText, TargetNullValue=—}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Muted}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
          <Canvas Grid.Row="1" x:Name="SelectionCanvas" Margin="0" IsHitTestVisible="False" Panel.ZIndex="10">
