<Window x:Class="MakanDownloadManager.MainWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MakanDownloadManager"
        Title="Epsilon Download Manager" Width="1240" Height="740" MinWidth="920" MinHeight="500" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <!-- v6 icon set (Lucide outlines): drawn as vectors, so they look the same on every PC and do not depend on an icon font. -->
    <Geometry x:Key="IcoAdd">M 5 12 h 14 M 12 5 v 14</Geometry>
    <Geometry x:Key="IcoTorrent">M 12 15 l 4 4 M 2.352 10.648 a 1.205 1.205 0 0 0 0 1.704 l 2.296 2.296 a 1.205 1.205 0 0 0 1.704 0 l 6.029 -6.029 a 1 1 0 1 1 3 3 l -6.029 6.029 a 1.205 1.205 0 0 0 0 1.704 l 2.296 2.296 a 1.205 1.205 0 0 0 1.704 0 l 6.365 -6.367 A 1 1 0 0 0 8.716 4.282 z M 5 8 l 4 4</Geometry>
    <Geometry x:Key="IcoResume">M 9 9.003 a 1 1 0 0 1 1.517 -0.859 l 4.997 2.997 a 1 1 0 0 1 0 1.718 l -4.997 2.997 A 1 1 0 0 1 9 14.996 z M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z</Geometry>
    <Geometry x:Key="IcoStop">M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z M 10 15 L 10 9 M 14 15 L 14 9</Geometry>
    <Geometry x:Key="IcoStopAll">M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z M 10 9 H 14 A 1 1 0 0 1 15 10 V 14 A 1 1 0 0 1 14 15 H 10 A 1 1 0 0 1 9 14 V 10 A 1 1 0 0 1 10 9 Z</Geometry>
    <Geometry x:Key="IcoDelete">M 10 11 v 6 M 14 11 v 6 M 19 6 v 14 a 2 2 0 0 1 -2 2 H 7 a 2 2 0 0 1 -2 -2 V 6 M 3 6 h 18 M 8 6 V 4 a 2 2 0 0 1 2 -2 h 4 a 2 2 0 0 1 2 2 v 2</Geometry>
    <Geometry x:Key="IcoSchedule">M 16 14 v 2.2 l 1.6 1 M 16 2 v 4 M 21 7.5 V 6 a 2 2 0 0 0 -2 -2 H 5 a 2 2 0 0 0 -2 2 v 14 a 2 2 0 0 0 2 2 h 3.5 M 3 10 h 5 M 8 2 v 4 M 10 16 A 6 6 0 1 0 22 16 A 6 6 0 1 0 10 16 Z</Geometry>
    <Geometry x:Key="IcoQueues">M 8 5 h 13 M 13 12 h 8 M 13 19 h 8 M 3 10 a 2 2 0 0 0 2 2 h 3 M 3 5 v 12 a 2 2 0 0 0 2 2 h 3</Geometry>
    <Geometry x:Key="IcoGrabber">M 21.54 15 H 17 a 2 2 0 0 0 -2 2 v 4.54 M 7 3.34 V 5 a 3 3 0 0 0 3 3 a 2 2 0 0 1 2 2 c 0 1.1 0.9 2 2 2 a 2 2 0 0 0 2 -2 c 0 -1.1 0.9 -2 2 -2 h 3.17 M 11 21.95 V 18 a 2 2 0 0 0 -2 -2 a 2 2 0 0 1 -2 -2 v -1 a 2 2 0 0 0 -2 -2 H 2.05 M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z</Geometry>
    <Geometry x:Key="IcoMultiNet">M 10.586 5.414 l -5.172 5.172 M 18.586 13.414 l -5.172 5.172 M 6 12 h 12 M 10 20 A 2 2 0 1 0 14 20 A 2 2 0 1 0 10 20 Z M 10 4 A 2 2 0 1 0 14 4 A 2 2 0 1 0 10 4 Z M 18 12 A 2 2 0 1 0 22 12 A 2 2 0 1 0 18 12 Z M 2 12 A 2 2 0 1 0 6 12 A 2 2 0 1 0 2 12 Z</Geometry>
    <Geometry x:Key="IcoLimiter">M 12 14 l 4 -4 M 3.34 19 a 10 10 0 1 1 17.32 0</Geometry>
    <Geometry x:Key="IcoSpeedTest">M 4 18 a 9 9 0 1 1 16 0 M 12 13 l 5 -5 M 7 18 h 10</Geometry>
    <Geometry x:Key="IcoThemes">M 11 17 a 4 4 0 0 1 -8 0 V 5 a 2 2 0 0 1 2 -2 h 4 a 2 2 0 0 1 2 2 Z M 16.7 13 H 19 a 2 2 0 0 1 2 2 v 4 a 2 2 0 0 1 -2 2 H 7 M 7 17 h 0.01 M 11 8 l 2.3 -2.3 a 2.4 2.4 0 0 1 3.404 0.004 L 18.6 7.6 a 2.4 2.4 0 0 1 0.026 3.434 L 9.9 19.8</Geometry>
    <Geometry x:Key="IcoOptions">M 10 5 H 3 M 12 19 H 3 M 14 3 v 4 M 16 17 v 4 M 21 12 h -9 M 21 19 h -5 M 21 5 h -7 M 8 10 v 4 M 8 12 H 3</Geometry>
    <Geometry x:Key="IcoSpark">M 11.017 2.814 a 1 1 0 0 1 1.966 0 l 1.051 5.558 a 2 2 0 0 0 1.594 1.594 l 5.558 1.051 a 1 1 0 0 1 0 1.966 l -5.558 1.051 a 2 2 0 0 0 -1.594 1.594 l -1.051 5.558 a 1 1 0 0 1 -1.966 0 l -1.051 -5.558 a 2 2 0 0 0 -1.594 -1.594 l -5.558 -1.051 a 1 1 0 0 1 0 -1.966 l 5.558 -1.051 a 2 2 0 0 0 1.594 -1.594 z M 20 2 v 4 M 22 4 h -4 M 2 20 A 2 2 0 1 0 6 20 A 2 2 0 1 0 2 20 Z</Geometry>
    <Style x:Key="IcoPath" TargetType="Path"><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/></Style>
    <!-- v1.7 command button: clean vertical icon + label, based on the approved v6 preview. -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="MinWidth" Value="66"/>
      <Setter Property="Height" Value="66"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- v6 filter chips: clear counts/categories without a permanent sidebar. -->
    <Style x:Key="CanvasTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabBorder" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="13,7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a row in the toolbar's "More" overflow popup: icon on the left, full-width label, left-aligned -->
    <Style x:Key="ToolMenuRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- list rows: roomy download cards -->
    <Style x:Key="RowStyle" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="14,11,10,10"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Approved v6 shell: brand/menu row, clean vertical commands, then download filters. -->
    <StackPanel DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}">
      <Grid Height="58" Margin="16,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Circular glass brand medallion. Every visible layer is round; the source PNG stays at full
               quality and an accent-coloured copy lets the badge follow the active theme. -->
          <Grid Width="44" Height="44" Margin="0,0,11,0" SnapsToDevicePixels="True">
            <Ellipse Fill="{DynamicResource Panel2}" Stroke="{DynamicResource Accent}" StrokeThickness="1.25">
              <Ellipse.Effect><DropShadowEffect Color="Black" BlurRadius="11" ShadowDepth="2" Opacity="0.34"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Margin="2" Fill="{DynamicResource Accent}" Opacity="0.13"/>
            <Ellipse Margin="3" Stroke="#42FFFFFF" StrokeThickness="0.8"/>
            <Grid Margin="7">
              <Image Source="Assets/epsilon-logo-hq.png" Stretch="Uniform" Opacity="0.82"
                     RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
              <Ellipse Fill="{DynamicResource Accent}" Opacity="0.30">
                <Ellipse.OpacityMask><ImageBrush ImageSource="Assets/epsilon-logo-hq.png" Stretch="Uniform"/></Ellipse.OpacityMask>
              </Ellipse>
            </Grid>
            <Ellipse Height="14" Margin="5,4,5,0" VerticalAlignment="Top" IsHitTestVisible="False">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                  <GradientStop Color="#66FFFFFF" Offset="0"/>
                  <GradientStop Color="#18FFFFFF" Offset="0.55"/>
                  <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="Epsilon Download Manager" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock Text="Fast, intelligent and private downloading" FontSize="11.5" Foreground="{DynamicResource Muted}"/></StackPanel>
        </StackPanel>
        <Menu Grid.Column="1" Margin="24,0,0,0" Background="Transparent" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontSize="13">
          <MenuItem Header="Tasks"><MenuItem Header="Add URL" Click="Add_Click" InputGestureText="Ctrl+N"/><MenuItem Header="Add batch download" Click="AddBatch_Click"/><MenuItem Header="Add from clipboard" Click="Clipboard_Click" InputGestureText="Ctrl+V"/><MenuItem Header="Add torrent or magnet" Click="AddTorrent_Click"/><Separator/><MenuItem Header="Import from text file…" Click="ImportText_Click"/><MenuItem Header="Export to text file…" Click="ExportText_Click"/><Separator/><MenuItem Header="Exit" Click="Exit_Click"/></MenuItem>
          <MenuItem Header="File"><MenuItem Header="Open" Click="Open_Click" InputGestureText="Enter"/><MenuItem Header="Open folder" Click="OpenFolder_Click"/><MenuItem Header="Copy address" Click="CopyUrl_Click"/><Separator/><MenuItem Header="Redownload" Click="Retry_Click"/><MenuItem Header="History" Click="History_Click"/></MenuItem>
          <MenuItem Header="Downloads"><MenuItem Header="Resume" Click="Start_Click" InputGestureText="Ctrl+R"/><MenuItem Header="Stop" Click="Pause_Click" InputGestureText="Ctrl+S"/><MenuItem Header="Resume all" Click="StartAll_Click"/><MenuItem Header="Stop all" Click="StopAll_Click"/><Separator/><MenuItem Header="Delete…" Click="Remove_Click" InputGestureText="Del"/><MenuItem Header="Delete all finished" Click="DeleteCompleted_Click"/><MenuItem Header="Reset remembered delete choice" Click="ResetDeleteChoice_Click"/><Separator/><MenuItem Header="Raise priority" Click="PriorityUp_Click"/><MenuItem Header="Lower priority" Click="PriorityDown_Click"/></MenuItem>
          <MenuItem x:Name="QueuesMenu" Header="Queues" SubmenuOpened="QueuesMenu_Opened"><MenuItem Header="New queue…" Click="NewQueue_Click"/></MenuItem>
          <MenuItem Header="View"><MenuItem Header="Themes…" Click="Themes_Click"/><Separator/><MenuItem Header="Newest first" Tag="Id:Descending" Click="Sort_Click"/><MenuItem Header="Name" Tag="FileName:Ascending" Click="Sort_Click"/><MenuItem Header="Size" Tag="TotalBytes:Descending" Click="Sort_Click"/><MenuItem Header="Status" Tag="Status:Ascending" Click="Sort_Click"/><MenuItem Header="Speed" Tag="SpeedBytesPerSec:Descending" Click="Sort_Click"/><Separator/><MenuItem x:Name="CompactRowsItem" Header="Compact rows" IsCheckable="True" Click="CompactRows_Click"/><MenuItem Header="Intelligent Center" Click="Center_Click"/></MenuItem>
          <MenuItem Header="Tools"><MenuItem Header="Network speed test…" Click="SpeedTest_Click"/><Separator/><MenuItem Header="Multi-Network…" Click="MultiNet_Click"/><MenuItem Header="Speed limiter…" Click="SpeedLimiter_Click"/><MenuItem Header="Site grabber" Click="SiteGrabber_Click"/><MenuItem Header="Scheduler and queues…" Click="Scheduler_Click"/><MenuItem Header="Export diagnostic report…" Click="Diagnostics_Click"/><Separator/><MenuItem Header="Options…" Click="Settings_Click"/></MenuItem>
          <MenuItem Header="Help"><MenuItem Header="Getting started" Click="GettingStarted_Click"/><MenuItem Header="Report a bug…" Click="ReportBug_Click"/><Separator/><MenuItem Header="About Epsilon" Click="About_Click"/></MenuItem>
        </Menu>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="SmartDot" Visibility="Collapsed"/><Viewbox Width="17" Height="17" HorizontalAlignment="Center" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoSpark}" Stroke="#26A66F" Style="{StaticResource IcoPath}"/></Canvas></Viewbox>
          <StackPanel><TextBlock x:Name="SmartText" Text="Smart engine on" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/><TextBlock x:Name="BrowserText" Text="Browser connected" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
          <Border x:Name="BrowserDot" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <Border x:Name="ToolbarBar" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" Background="{DynamicResource Panel}" Padding="10,5">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BtnMultiNet" Style="{StaticResource ToolBtn}" Click="MultiNet_Click" ToolTip="Multi-Network: download over several internet connections at once"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoMultiNet}" Stroke="#7568DF" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Multi-Net"/><TextBlock x:Name="MultiNetGlyph" Visibility="Collapsed"/><TextBlock x:Name="MultiNetCaption" Visibility="Collapsed"/><TextBlock x:Name="MultiNetState" Text="Off" FontSize="10.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="BtnSpeedLimiter" Style="{StaticResource ToolBtn}" Click="SpeedLimiter_Click" ToolTip="Speed limiter"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoLimiter}" Stroke="#E17700" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Limiter"/><TextBlock x:Name="SpeedLimiterCaption" Text="Off" FontSize="10.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="BtnThemes" Style="{StaticResource ToolBtn}" Click="Themes_Click" ToolTip="Themes"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoThemes}" Stroke="#B865B5" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Themes"/></StackPanel></Button>
            <Button Style="{StaticResource ToolBtn}" Click="Settings_Click" ToolTip="Options"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoOptions}" Stroke="#64788E" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Options"/></StackPanel></Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolBtn}" Click="Add_Click" ToolTip="Add URL (Ctrl+N)"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoAdd}" Stroke="#287FE1" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Add URL"/></StackPanel></Button>
            <Button Style="{StaticResource ToolBtn}" Click="AddTorrent_Click" ToolTip="Add a torrent or magnet link"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoTorrent}" Stroke="#D21C67" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Torrent"/></StackPanel></Button>
            <Button x:Name="BtnResume" Style="{StaticResource ToolBtn}" Click="Start_Click" ToolTip="Resume (Ctrl+R)"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoResume}" Stroke="#26A66F" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Resume"/></StackPanel></Button>
            <Button x:Name="BtnStop" Style="{StaticResource ToolBtn}" Click="Pause_Click" ToolTip="Stop (Ctrl+S)"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoStop}" Stroke="#C28722" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Stop"/></StackPanel></Button>
            <Button x:Name="BtnStopAllTop" Style="{StaticResource ToolBtn}" Click="StopAll_Click" ToolTip="Stop every running download"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoStopAll}" Stroke="#D84F5F" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Stop all"/></StackPanel></Button>
            <Button x:Name="BtnDelete" Style="{StaticResource ToolBtn}" Click="Remove_Click" ToolTip="Delete (Del)"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoDelete}" Stroke="#D84F5F" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Delete"/></StackPanel></Button>
            <Border Style="{StaticResource ToolSeparator}"/>
            <Button Style="{StaticResource ToolBtn}" Click="Scheduler_Click" ToolTip="Scheduler"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoSchedule}" Stroke="#7452D2" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Schedule"/></StackPanel></Button>
            <Button x:Name="BtnQueues" Style="{StaticResource ToolBtn}" Click="QueuesButton_Click" ToolTip="Queues: start, stop, new queue, files at the same time"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoQueues}" Stroke="#087B91" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Queues"/></StackPanel></Button>
            <Button Style="{StaticResource ToolBtn}" Click="SiteGrabber_Click" ToolTip="Site grabber"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoGrabber}" Stroke="#007D8C" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Grabber"/></StackPanel></Button>
            <Button Style="{StaticResource ToolBtn}" Click="SpeedTest_Click" ToolTip="Network speed test"><StackPanel><Viewbox Width="21" Height="21" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoSpeedTest}" Stroke="#2E86FF" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><TextBlock Style="{StaticResource ToolCaption}" Text="Speed test"/></StackPanel></Button>
            <Button x:Name="BtnStartAllTop" Visibility="Collapsed"/><Button x:Name="BtnMore" Visibility="Collapsed"/><Button x:Name="BtnDeleteCompleted" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Margin="18,13,18,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Downloads" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock x:Name="CanvasSummary" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Margin="0,0,24,0"><TextBlock Text="Download" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderDownloadSpeed" Text="0 B/s" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Margin="0,0,24,0"><TextBlock Text="Upload" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderUploadSpeed" Text="0 B/s" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/></StackPanel>
          <StackPanel><TextBlock Text="Active" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderActiveCount" Text="0 items" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/></StackPanel>
        </StackPanel>
      </Grid>
      <Grid Margin="18,0,18,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="FilterAll" Style="{StaticResource CanvasTab}" Content="All" Tag="all" GroupName="CanvasFilter" IsChecked="True" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterFiles" Style="{StaticResource CanvasTab}" Content="Files" Tag="files" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterTorrents" Style="{StaticResource CanvasTab}" Content="Torrents" Tag="torrents" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterActive" Style="{StaticResource CanvasTab}" Content="Active" Tag="unfinished" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterFinished" Style="{StaticResource CanvasTab}" Content="Finished" Tag="finished" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterQueues" Visibility="Collapsed" Tag="queues" GroupName="CanvasFilter"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="9,0"><DockPanel><TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="8,7" TextChanged="SearchBox_TextChanged" ToolTip="Search downloads"/></DockPanel></Border>
      </Grid>
    </StackPanel>

    <!-- quick speed control; detailed connection settings remain available in Options -->
    <Popup x:Name="SpeedLimiterPopup" PlacementTarget="{Binding ElementName=BtnSpeedLimiter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="16" Width="310">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="Speed limiter" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
          <TextBlock x:Name="SpeedLimiterStatus" Margin="0,4,0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
          <TextBlock Text="Custom limit" FontSize="11" Foreground="{DynamicResource Muted}"/>
          <DockPanel Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Right" Text="KB/s" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            <TextBox x:Name="SpeedLimiterRateBox" Text="1024" Padding="8,6"/>
          </DockPanel>
          <ComboBox x:Name="SpeedLimiterScopeBox" SelectedIndex="0" Padding="6" Margin="0,0,0,10">
            <ComboBoxItem Content="All downloads combined"/>
            <ComboBoxItem Content="Each download"/>
          </ComboBox>
          <TextBlock Text="Quick limits" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
          <UniformGrid Columns="3" Margin="0,0,0,12">
            <Button Content="300 KB/s" Tag="300" Click="SpeedLimiterPreset_Click" Margin="0,0,4,0" Padding="5"/>
            <Button Content="1 MB/s" Tag="1024" Click="SpeedLimiterPreset_Click" Margin="2,0" Padding="5"/>
            <Button Content="5 MB/s" Tag="5120" Click="SpeedLimiterPreset_Click" Margin="4,0,0,0" Padding="5"/>
          </UniformGrid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Off (no limit)" Click="SpeedLimiterUnlimited_Click" Padding="7" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="Cancel" Click="SpeedLimiterCancel_Click" Padding="7" Margin="2,0"/>
            <Button Grid.Column="2" Content="Apply" Click="SpeedLimiterApply_Click" Padding="7" Margin="4,0,0,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="MultiNetPopup" PlacementTarget="{Binding ElementName=BtnMultiNet}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="17" Width="430" Margin="12">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/></Border.Effect>
        <StackPanel>
          <DockPanel Margin="0,0,0,12"><Viewbox Width="26" Height="26" Margin="0,0,10,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoMultiNet}" Stroke="#7568DF" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><StackPanel><TextBlock Text="Multi-Network" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Download one file over several internet connections at once" FontSize="11.5" Foreground="{DynamicResource Muted}"/></StackPanel></DockPanel>
          <UniformGrid Columns="2" Margin="0,0,0,10"><Button x:Name="MultiNetOnButton" Content="On" Click="MultiNetOn_Click" Padding="10,7" Margin="0,0,3,0"/><Button x:Name="MultiNetOffButton" Content="Off" Click="MultiNetOff_Click" Padding="10,7" Margin="3,0,0,0"/></UniformGrid>
          <TextBlock x:Name="MultiNetStatusText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,10"/>
          <TextBlock Text="Networks connected now (untick one to leave it out)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <StackPanel x:Name="MultiNetLinksPanel" Margin="0,0,0,10"/>
          <TextBlock Text="Share the connections" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="MultiNetBalanceBox" SelectionChanged="MultiNetOption_Changed" Padding="6" Margin="0,0,0,10">
            <ComboBoxItem Content="Automatic: the faster network gets more"/>
            <ComboBoxItem Content="Equal: the same number on each network"/>
          </ComboBox>
          <DockPanel Margin="0,0,0,8"><TextBlock Text="Only for files larger than" FontSize="12" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="MB" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/><TextBox x:Name="MultiNetMinBox" Width="70" HorizontalAlignment="Right" TextAlignment="Right" Padding="6,4" LostFocus="MultiNetOption_Changed"/></DockPanel>
          <CheckBox x:Name="MultiNetAvoidMeteredBox" Content="Never use metered/mobile networks" Checked="MultiNetOption_Changed" Unchecked="MultiNetOption_Changed" Margin="0,4"/>
          <CheckBox x:Name="MultiNetKeepOneFreeBox" Content="Keep the fastest network free for other apps" Checked="MultiNetOption_Changed" Unchecked="MultiNetOption_Changed" Margin="0,4"/>
          <CheckBox x:Name="MultiNetAskNewBox" Content="Require approval before using a new network" Checked="MultiNetOption_Changed" Unchecked="MultiNetOption_Changed" Margin="0,4"/>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Daily Multi-Net limit" VerticalAlignment="Center"/><TextBox x:Name="MultiNetDailyBox" Grid.Column="1" TextAlignment="Right" Padding="6,4" LostFocus="MultiNetOption_Changed"/><TextBlock Grid.Column="2" Text="MB (0 = unlimited)" Foreground="{DynamicResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid>
          <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Retry a dropped network after" VerticalAlignment="Center"/><TextBox x:Name="MultiNetRetryBox" Grid.Column="1" TextAlignment="Right" Padding="6,4" LostFocus="MultiNetOption_Changed"/><TextBlock Grid.Column="2" Text="minutes" Foreground="{DynamicResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid>
          <Button x:Name="MultiNetTestButton" Content="Test selected networks now" Click="MultiNetTest_Click" Style="{StaticResource PrimaryButton}" Margin="0,4,0,8"/>
          <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Muted}" Text="Applies to downloads that start or resume from now on. New networks stay unused until approved when that option is enabled. Torrents and video streams are not affected."/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- All built-in themes in one dedicated gallery.  The toolbar button opens this directly; themes are
         deliberately kept out of a generic overflow menu so the complete collection is always visible. -->
    <!-- Themes: one panel under the toolbar, as wide as the window, with every theme as a card (owner's design). -->
    <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ToolbarBar}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
           Width="{Binding ActualWidth, ElementName=ToolbarBar}">
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,14,16,16" Margin="0,0,0,18">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.16" Color="Black"/></Border.Effect>
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="✕" Click="ThemeClose_Click" ToolTip="Close" Style="{StaticResource ToolMenuRow}" Padding="8,3" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel><TextBlock Text="Themes" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock x:Name="CurrentThemeText" Text="Applied instantly across the app and extension" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
          </DockPanel>
          <UniformGrid x:Name="ThemeCards" Columns="6"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- "More" overflow popup -->
    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=BtnMore}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
