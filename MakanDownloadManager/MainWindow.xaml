    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,9">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Multi-Net " Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FooterMultiNet" Text="Off" FontWeight="SemiBold" Margin="0,0,16,0"/>
          <TextBlock Text="Limiter " Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FooterLimiter" Text="Off" FontWeight="SemiBold" Margin="0,0,16,0"/>
          <TextBlock Text="Browser " Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FooterBrowser" Text="Connected" FontWeight="SemiBold" Margin="0,0,16,0"/>
          <TextBlock Text="Disk free " Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FooterDisk" Text="—" FontWeight="SemiBold" Margin="0,0,18,0"/>
          <TextBlock x:Name="ActiveText" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <TextBlock x:Name="TotalSpeed" MinWidth="90" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="↓ 0 B/s" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
