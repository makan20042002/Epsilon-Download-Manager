<Window x:Class="MakanDownloadManager.MainWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MakanDownloadManager"
        Title="Epsilon Download Manager" Width="1360" Height="820" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <!-- v6 icon set (Lucide outlines): drawn as vectors, so they look the same on every PC and do not depend on an icon font. -->
    <Geometry x:Key="IcoAdd">M 5 12 h 14 M 12 5 v 14</Geometry>
    <Geometry x:Key="IcoTorrent">M 12 15 l 4 4 M 2.352 10.648 a 1.205 1.205 0 0 0 0 1.704 l 2.296 2.296 a 1.205 1.205 0 0 0 1.704 0 l 6.029 -6.029 a 1 1 0 1 1 3 3 l -6.029 6.029 a 1.205 1.205 0 0 0 0 1.704 l 2.296 2.296 a 1.205 1.205 0 0 0 1.704 0 l 6.365 -6.367 A 1 1 0 0 0 8.716 4.282 z M 5 8 l 4 4</Geometry>
    <Geometry x:Key="IcoResume">M 9 9.003 a 1 1 0 0 1 1.517 -0.859 l 4.997 2.997 a 1 1 0 0 1 0 1.718 l -4.997 2.997 A 1 1 0 0 1 9 14.996 z M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z</Geometry>
    <Geometry x:Key="IcoStop">M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z M 10 15 L 10 9 M 14 15 L 14 9</Geometry>
    <Geometry x:Key="IcoStopAll">M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z M 10 9 H 14 A 1 1 0 0 1 15 10 V 14 A 1 1 0 0 1 14 15 H 10 A 1 1 0 0 1 9 14 V 10 A 1 1 0 0 1 10 9 Z</Geometry>
    <Geometry x:Key="IcoDelete">M 10 11 v 6 M 14 11 v 6 M 19 6 v 14 a 2 2 0 0 1 -2 2 H 7 a 2 2 0 0 1 -2 -2 V 6 M 3 6 h 18 M 8 6 V 4 a 2 2 0 0 1 2 -2 h 4 a 2 2 0 0 1 2 2 v 2</Geometry>
    <Geometry x:Key="IcoSchedule">M 16 14 v 2.2 l 1.6 1 M 16 2 v 4 M 21 7.5 V 6 a 2 2 0 0 0 -2 -2 H 5 a 2 2 0 0 0 -2 2 v 14 a 2 2 0 0 0 2 2 h 3.5 M 3 10 h 5 M 8 2 v 4 M 10 16 A 6 6 0 1 0 22 16 A 6 6 0 1 0 10 16 Z</Geometry>
    <Geometry x:Key="IcoQueues">M 8 5 h 13 M 13 12 h 8 M 13 19 h 8 M 3 10 a 2 2 0 0 0 2 2 h 3 M 3 5 v 12 a 2 2 0 0 0 2 2 h 3</Geometry>
    <Geometry x:Key="IcoGrabber">M 21.54 15 H 17 a 2 2 0 0 0 -2 2 v 4.54 M 7 3.34 V 5 a 3 3 0 0 0 3 3 a 2 2 0 0 1 2 2 c 0 1.1 0.9 2 2 2 a 2 2 0 0 0 2 -2 c 0 -1.1 0.9 -2 2 -2 h 3.17 M 11 21.95 V 18 a 2 2 0 0 0 -2 -2 a 2 2 0 0 1 -2 -2 v -1 a 2 2 0 0 0 -2 -2 H 2.05 M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z</Geometry>
    <Geometry x:Key="IcoMultiNet">M 10.586 5.414 l -5.172 5.172 M 18.586 13.414 l -5.172 5.172 M 6 12 h 12 M 10 20 A 2 2 0 1 0 14 20 A 2 2 0 1 0 10 20 Z M 10 4 A 2 2 0 1 0 14 4 A 2 2 0 1 0 10 4 Z M 18 12 A 2 2 0 1 0 22 12 A 2 2 0 1 0 18 12 Z M 2 12 A 2 2 0 1 0 6 12 A 2 2 0 1 0 2 12 Z</Geometry>
    <Geometry x:Key="IcoLimiter">M 12 14 l 4 -4 M 3.34 19 a 10 10 0 1 1 17.32 0</Geometry>
    <Geometry x:Key="IcoSpeedTest">M 4 18 a 9 9 0 1 1 16 0 M 12 13 l 5 -5 M 7 18 h 10</Geometry>
    <Geometry x:Key="IcoThemes">M 11 17 a 4 4 0 0 1 -8 0 V 5 a 2 2 0 0 1 2 -2 h 4 a 2 2 0 0 1 2 2 Z M 16.7 13 H 19 a 2 2 0 0 1 2 2 v 4 a 2 2 0 0 1 -2 2 H 7 M 7 17 h 0.01 M 11 8 l 2.3 -2.3 a 2.4 2.4 0 0 1 3.404 0.004 L 18.6 7.6 a 2.4 2.4 0 0 1 0.026 3.434 L 9.9 19.8</Geometry>
    <Geometry x:Key="IcoOptions">M 10 5 H 3 M 12 19 H 3 M 14 3 v 4 M 16 17 v 4 M 21 12 h -9 M 21 19 h -5 M 21 5 h -7 M 8 10 v 4 M 8 12 H 3</Geometry>
    <Geometry x:Key="IcoSpark">M 11.017 2.814 a 1 1 0 0 1 1.966 0 l 1.051 5.558 a 2 2 0 0 0 1.594 1.594 l 5.558 1.051 a 1 1 0 0 1 0 1.966 l -5.558 1.051 a 2 2 0 0 0 -1.594 1.594 l -1.051 5.558 a 1 1 0 0 1 -1.966 0 l -1.051 -5.558 a 2 2 0 0 0 -1.594 -1.594 l -5.558 -1.051 a 1 1 0 0 1 0 -1.966 l 5.558 -1.051 a 2 2 0 0 0 1.594 -1.594 z M 20 2 v 4 M 22 4 h -4 M 2 20 A 2 2 0 1 0 6 20 A 2 2 0 1 0 2 20 Z</Geometry>
    <Style x:Key="IcoPath" TargetType="Path"><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/></Style>
    <!-- v1.7 command button: clean vertical icon + label, based on the approved v6 preview. -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="MinWidth" Value="70"/>
      <!-- Multi-Net and Limiter have a second status line.  Keep enough real height for it at
           Windows display scaling levels instead of letting the toolbar divider clip it. -->
      <Setter Property="Height" Value="94"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolIconTile" TargetType="Border">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="9" ShadowDepth="2" Opacity="0.20" Color="#273A61"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolTilePath" TargetType="Path" BasedOn="{StaticResource IcoPath}">
      <Setter Property="Stroke" Value="White"/>
      <Setter Property="StrokeThickness" Value="1.9"/>
    </Style>
    <Style x:Key="ToolCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- Permanent 1.8 navigation.  This is part of the real window, not a preview-only decoration. -->
    <Style x:Key="SideNavRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="9,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="9,6" BorderThickness="1" BorderBrush="Transparent">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="NavAccent" Width="3" CornerRadius="2" Background="{DynamicResource Accent}" Opacity="0"/>
                <ContentPresenter Grid.Column="1"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Selected}"/><Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource Border}"/><Setter TargetName="NavAccent" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SideNavButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="9,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Hover}"/><Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SideIconTile" TargetType="Border">
      <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SideIconGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- v6 filter chips: clear counts/categories without a permanent sidebar. -->
    <Style x:Key="CanvasTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="0" Padding="10,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a row in the toolbar's "More" overflow popup: icon on the left, full-width label, left-aligned -->
    <Style x:Key="ToolMenuRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- list rows: roomy download cards -->
    <Style x:Key="RowStyle" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <GridViewRowPresenter Content="{TemplateBinding Content}"
                                    Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="9,9"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
  </Window.Resources>

  <Grid Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- The approved preview's permanent, colourful library navigation. -->
    <Border Grid.Column="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,8,12,16"><Grid Width="40" Height="40" Margin="0,0,10,0"><Ellipse Fill="{DynamicResource Panel2}" Stroke="{DynamicResource Accent}" StrokeThickness="1.2"/><Image Source="Assets/epsilon-logo-hq.png" Margin="7" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/></Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Epsilon" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/><TextBlock Text="v2.0.0" FontSize="9.5" Foreground="{DynamicResource Faint}" Margin="0,2,0,0"/></StackPanel></StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <RadioButton GroupName="SideNav" x:Name="SideDownloads" IsChecked="True" Tag="all" Click="SidebarFilter_Click" Style="{StaticResource SideNavRadio}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE896;"/></Border><TextBlock Text="Downloads" VerticalAlignment="Center"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Selected}" CornerRadius="10" MinWidth="22" Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="SideBadgeAll" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border></Grid></RadioButton>
            <Button Style="{StaticResource SideNavButton}" Click="Scheduler_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE8FD;"/></Border><TextBlock Text="Queues" VerticalAlignment="Center"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Selected}" CornerRadius="10" MinWidth="22" Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="SideBadgeQueues" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border></Grid></Button>
            <RadioButton GroupName="SideNav" Tag="torrents" Click="SidebarFilter_Click" Style="{StaticResource SideNavRadio}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE8B7;"/></Border><TextBlock Text="Torrents" VerticalAlignment="Center"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Selected}" CornerRadius="10" MinWidth="22" Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="SideBadgeTorrents" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border></Grid></RadioButton>
            <Button Style="{StaticResource SideNavButton}" Click="MultiNet_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE968;"/></Border><TextBlock Text="Multi-Network" VerticalAlignment="Center"/></StackPanel></Grid></Button>
            <Button Style="{StaticResource SideNavButton}" Click="Scheduler_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE787;"/></Border><TextBlock Text="Scheduler" VerticalAlignment="Center"/></StackPanel></Grid></Button>
            <Button Style="{StaticResource SideNavButton}" Click="SpeedLimiter_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE9D9;"/></Border><TextBlock Text="Speed Limiter" VerticalAlignment="Center"/></StackPanel></Grid></Button>
            <Button Style="{StaticResource SideNavButton}" Click="Settings_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE774;"/></Border><TextBlock Text="Browser Integration" VerticalAlignment="Center"/></StackPanel></Grid></Button>
            <Button Style="{StaticResource SideNavButton}" Click="Media_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE714;"/></Border><TextBlock Text="Media Capture" VerticalAlignment="Center"/></StackPanel></Grid></Button>
            <Button Style="{StaticResource SideNavButton}" Click="RemoteSidebar_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE839;"/></Border><TextBlock Text="Remote Control" VerticalAlignment="Center"/></StackPanel></Grid></Button>
            <Button Style="{StaticResource SideNavButton}" Click="History_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE81C;"/></Border><TextBlock Text="History" VerticalAlignment="Center"/></StackPanel></Grid></Button>
            <Button Style="{StaticResource SideNavButton}" Click="Settings_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Style="{StaticResource SideIconTile}"><TextBlock Style="{StaticResource SideIconGlyph}" Text="&#xE713;"/></Border><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Grid></Button>
            <StackPanel Visibility="Collapsed"><StackPanel x:Name="SideQueueList"/><TextBlock x:Name="SideAllCount"/><TextBlock x:Name="SideFinishedCount"/></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

  <DockPanel Grid.Column="1">
    <!-- V2 shell: a compact command bar, live dashboard cards and the full data table. -->
    <StackPanel x:Name="HeaderShell" DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}">
      <Grid Height="58" Margin="14,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource BrandGrad}" Margin="0,0,11,0"><TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Epsilon Download Manager" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Text="Fluent • Fast • Powerful" FontSize="10.5" Foreground="{DynamicResource Muted}"/></StackPanel>
        </StackPanel>
        <Border Grid.Column="1" MaxWidth="460" Height="34" VerticalAlignment="Center" Margin="22,0" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="7" Padding="9,0">
          <DockPanel><TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><Grid><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" ToolTip="Search downloads; paste a link and press Enter to add it"/><TextBlock Text="Search downloads, paste links, or enter a filename..." FontSize="12" Foreground="{DynamicResource Faint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Viewbox Width="15" Height="15" Margin="0,0,6,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoSpark}" Stroke="{DynamicResource Success}" Style="{StaticResource IcoPath}"/></Canvas></Viewbox><StackPanel><TextBlock x:Name="SmartText" Text="Smart engine on" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/><TextBlock x:Name="BrowserText" Text="Browser connected" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel><Border x:Name="SmartDot" Visibility="Collapsed"/><Border x:Name="BrowserDot" Visibility="Collapsed"/></StackPanel>
          <Button Click="Add_Click" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="17" Margin="0,-1,6,0"/><TextBlock Text="Add Download" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="BtnMore" Click="More_Click" Content="☰" FontSize="17" Padding="10,6" Margin="0" ToolTip="All commands"/>
        </StackPanel>

        <!-- Kept in the visual tree for keyboard/accessibility and for existing command wiring. -->
        <Menu Visibility="Collapsed">
          <MenuItem Header="Tasks"><MenuItem Header="Add URL" Click="Add_Click" InputGestureText="Ctrl+N"/><MenuItem Header="Add batch download" Click="AddBatch_Click"/><MenuItem Header="Add from clipboard" Click="Clipboard_Click" InputGestureText="Ctrl+V"/><MenuItem Header="Add torrent or magnet" Click="AddTorrent_Click"/><Separator/><MenuItem Header="Import from text file…" Click="ImportText_Click"/><MenuItem Header="Export to text file…" Click="ExportText_Click"/><Separator/><MenuItem Header="Exit" Click="Exit_Click"/></MenuItem>
          <MenuItem Header="File"><MenuItem Header="Open" Click="Open_Click" InputGestureText="Enter"/><MenuItem Header="Open folder" Click="OpenFolder_Click"/><MenuItem Header="Copy address" Click="CopyUrl_Click"/><Separator/><MenuItem Header="Redownload" Click="Retry_Click"/><MenuItem Header="History" Click="History_Click"/></MenuItem>
