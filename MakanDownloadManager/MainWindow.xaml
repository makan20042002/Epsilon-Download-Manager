<Window x:Class="MakanDownloadManager.MainWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epsilon Download Manager" Width="1240" Height="740" MinWidth="920" MinHeight="500" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <!-- v1.7 command button: clean vertical icon + label, based on the approved v6 preview. -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="MinWidth" Value="62"/>
      <Setter Property="Height" Value="70"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Margin" Value="7,8"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- v6 filter chips: clear counts/categories without a permanent sidebar. -->
    <Style x:Key="CanvasTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabBorder" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="13,7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a row in the toolbar's "More" overflow popup: icon on the left, full-width label, left-aligned -->
    <Style x:Key="ToolMenuRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- list rows: roomy download cards -->
    <Style x:Key="RowStyle" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,8"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Approved v6 shell: brand/menu row, clean vertical commands, then download filters. -->
    <StackPanel DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}">
      <Grid Height="58" Margin="16,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/makan.ico" Width="38" Height="38" Margin="0,0,10,0"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="Epsilon Download Manager" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock Text="Fast, intelligent and private downloading" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
        </StackPanel>
        <Menu Grid.Column="1" Margin="24,0,0,0" Background="Transparent" Foreground="{DynamicResource Muted}" VerticalAlignment="Center">
          <MenuItem Header="Tasks"><MenuItem Header="Add URL" Click="Add_Click" InputGestureText="Ctrl+N"/><MenuItem Header="Add torrent" Click="AddTorrent_Click"/><Separator/><MenuItem Header="Options" Click="Settings_Click"/></MenuItem>
          <MenuItem Header="File"><MenuItem Header="Open" Click="Open_Click"/><MenuItem Header="Open folder" Click="OpenFolder_Click"/></MenuItem>
          <MenuItem Header="Downloads"><MenuItem Header="Resume" Click="Start_Click" InputGestureText="Ctrl+R"/><MenuItem Header="Stop" Click="Pause_Click" InputGestureText="Ctrl+S"/><MenuItem Header="Stop all" Click="StopAll_Click"/><Separator/><MenuItem Header="Delete…" Click="Remove_Click" InputGestureText="Del"/><MenuItem Header="Reset remembered delete choice" Click="ResetDeleteChoice_Click"/></MenuItem>
          <MenuItem Header="View"><MenuItem Header="Newest first" Tag="Id:Descending" Click="Sort_Click"/><MenuItem Header="Name" Tag="FileName:Ascending" Click="Sort_Click"/><MenuItem Header="Size" Tag="TotalBytes:Descending" Click="Sort_Click"/><MenuItem Header="Status" Tag="Status:Ascending" Click="Sort_Click"/><MenuItem Header="Speed" Tag="SpeedBytesPerSec:Descending" Click="Sort_Click"/></MenuItem>
          <MenuItem Header="Tools"><MenuItem Header="Scheduler &amp; queues" Click="Scheduler_Click"/><MenuItem Header="Site grabber" Click="SiteGrabber_Click"/><MenuItem Header="Intelligent Center" Click="Center_Click"/></MenuItem>
          <MenuItem Header="Help"><MenuItem Header="About Epsilon"/></MenuItem>
        </Menu>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="SmartDot" Width="9" Height="9" CornerRadius="5" Background="{DynamicResource Success}" Margin="0,0,8,0"/>
          <StackPanel><TextBlock x:Name="SmartText" Text="Smart engine on" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/><TextBlock x:Name="BrowserText" Text="Browser connected" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel>
          <Border x:Name="BrowserDot" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1" Background="{DynamicResource Panel}" Padding="12,5">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ToolBtn}" Click="Add_Click" ToolTip="Add URL (Ctrl+N)"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" Foreground="{DynamicResource Accent}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Add URL"/></StackPanel></Button>
          <Button Style="{StaticResource ToolBtn}" Click="AddTorrent_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8B7;" Foreground="{DynamicResource IconPurple}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Torrent"/></StackPanel></Button>
          <Button x:Name="BtnResume" Style="{StaticResource ToolBtn}" Click="Start_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;" Foreground="{DynamicResource Success}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Resume"/></StackPanel></Button>
          <Button x:Name="BtnStop" Style="{StaticResource ToolBtn}" Click="Pause_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE769;" Foreground="{DynamicResource Warning}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Stop"/></StackPanel></Button>
          <Button x:Name="BtnStopAllTop" Style="{StaticResource ToolBtn}" Click="StopAll_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" Foreground="{DynamicResource Danger}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Stop all"/></StackPanel></Button>
          <Button x:Name="BtnDelete" Style="{StaticResource ToolBtn}" Click="Remove_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" Foreground="{DynamicResource Danger}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Delete"/></StackPanel></Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button Style="{StaticResource ToolBtn}" Click="Scheduler_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE787;" Foreground="{DynamicResource IconPurple}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Schedule"/></StackPanel></Button>
          <Button Style="{StaticResource ToolBtn}" Click="Scheduler_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8FD;" Foreground="{DynamicResource IconTeal}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Queues"/></StackPanel></Button>
          <Button Style="{StaticResource ToolBtn}" Click="SiteGrabber_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE774;" Foreground="{DynamicResource Success}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Grabber"/></StackPanel></Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnMultiNet" Style="{StaticResource ToolBtn}" Click="MultiNet_Click"><StackPanel><TextBlock x:Name="MultiNetGlyph" Style="{StaticResource ToolGlyph}" Text="&#xE968;" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="MultiNetCaption" Style="{StaticResource ToolCaption}" Text="Multi-Net"/><TextBlock x:Name="MultiNetState" Text="Off" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="BtnSpeedLimiter" Style="{StaticResource ToolBtn}" Click="SpeedLimiter_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE9D9;" Foreground="{DynamicResource Warning}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Limiter"/><TextBlock x:Name="SpeedLimiterCaption" Text="Off" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnThemes" Style="{StaticResource ToolBtn}" Click="Themes_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" Foreground="{DynamicResource IconPurple}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Themes"/></StackPanel></Button>
          <Button Style="{StaticResource ToolBtn}" Click="Settings_Click"><StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" Foreground="{DynamicResource Muted}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Options"/></StackPanel></Button>
          <Button x:Name="BtnStartAllTop" Visibility="Collapsed"/><Button x:Name="BtnMore" Visibility="Collapsed"/><Button x:Name="BtnDeleteCompleted" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Grid Margin="18,13,18,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Downloads" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock x:Name="CanvasSummary" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Margin="0,0,24,0"><TextBlock Text="Download" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderDownloadSpeed" Text="0 B/s" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Margin="0,0,24,0"><TextBlock Text="Upload" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderUploadSpeed" Text="0 B/s" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/></StackPanel>
          <StackPanel><TextBlock Text="Active" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderActiveCount" Text="0 items" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/></StackPanel>
        </StackPanel>
      </Grid>
      <Grid Margin="18,0,18,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="FilterAll" Style="{StaticResource CanvasTab}" Content="All" Tag="all" GroupName="CanvasFilter" IsChecked="True" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterFiles" Style="{StaticResource CanvasTab}" Content="Files" Tag="files" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterTorrents" Style="{StaticResource CanvasTab}" Content="Torrents" Tag="torrents" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterActive" Style="{StaticResource CanvasTab}" Content="Active" Tag="unfinished" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterFinished" Style="{StaticResource CanvasTab}" Content="Finished" Tag="finished" GroupName="CanvasFilter" Click="FilterTab_Click"/>
          <RadioButton x:Name="FilterQueues" Visibility="Collapsed" Tag="queues" GroupName="CanvasFilter"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="9,0"><DockPanel><TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="8,7" TextChanged="SearchBox_TextChanged" ToolTip="Search downloads"/></DockPanel></Border>
      </Grid>
    </StackPanel>

    <!-- quick speed control; detailed connection settings remain available in Options -->
    <Popup x:Name="SpeedLimiterPopup" PlacementTarget="{Binding ElementName=BtnSpeedLimiter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="16" Width="310">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="Speed limiter" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
          <TextBlock x:Name="SpeedLimiterStatus" Margin="0,4,0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
          <TextBlock Text="Custom limit" FontSize="11" Foreground="{DynamicResource Muted}"/>
          <DockPanel Margin="0,4,0,8">
            <TextBlock DockPanel.Dock="Right" Text="KB/s" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            <TextBox x:Name="SpeedLimiterRateBox" Text="1024" Padding="8,6"/>
          </DockPanel>
          <ComboBox x:Name="SpeedLimiterScopeBox" SelectedIndex="0" Padding="6" Margin="0,0,0,10">
            <ComboBoxItem Content="All downloads combined"/>
            <ComboBoxItem Content="Each download"/>
          </ComboBox>
          <TextBlock Text="Quick limits" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
          <UniformGrid Columns="3" Margin="0,0,0,12">
            <Button Content="300 KB/s" Tag="300" Click="SpeedLimiterPreset_Click" Margin="0,0,4,0" Padding="5"/>
            <Button Content="1 MB/s" Tag="1024" Click="SpeedLimiterPreset_Click" Margin="2,0" Padding="5"/>
            <Button Content="5 MB/s" Tag="5120" Click="SpeedLimiterPreset_Click" Margin="4,0,0,0" Padding="5"/>
          </UniformGrid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Unlimited" Click="SpeedLimiterUnlimited_Click" Padding="7" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="Cancel" Click="SpeedLimiterCancel_Click" Padding="7" Margin="2,0"/>
            <Button Grid.Column="2" Content="Apply" Click="SpeedLimiterApply_Click" Padding="7" Margin="4,0,0,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="MultiNetPopup" PlacementTarget="{Binding ElementName=BtnMultiNet}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="17" Width="390">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/></Border.Effect>
        <StackPanel>
          <DockPanel Margin="0,0,0,12"><TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="25" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Multi-Network" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Combine available internet connections" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></DockPanel>
          <UniformGrid Columns="2" Margin="0,0,0,12"><Button x:Name="MultiNetOnButton" Content="On" Click="MultiNetOn_Click" Padding="10,7" Margin="0,0,3,0"/><Button x:Name="MultiNetOffButton" Content="Off" Click="MultiNetOff_Click" Padding="10,7" Margin="3,0,0,0"/></UniformGrid>
          <TextBlock x:Name="MultiNetStatusText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,7"><DockPanel><TextBlock Text="Wi-Fi" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="Available" Foreground="{DynamicResource Success}"/></DockPanel></Border>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="11"><DockPanel><TextBlock Text="Ethernet / tethering" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="Auto-detected" Foreground="{DynamicResource Accent}"/></DockPanel></Border>
          <CheckBox Content="Automatically balance segments between active networks" IsChecked="True" Margin="2,13,0,0" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- All built-in themes in one dedicated gallery.  The toolbar button opens this directly; themes are
         deliberately kept out of a generic overflow menu so the complete collection is always visible. -->
    <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=BtnThemes}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="16" Width="570">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/></Border.Effect>
        <StackPanel>
          <DockPanel Margin="2,0,2,12">
            <StackPanel><TextBlock Text="Themes" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CurrentThemeText" Text="12 palettes" FontSize="10.5" Foreground="{DynamicResource Muted}"/></StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource IconPurple}" VerticalAlignment="Center"/>
          </DockPanel>
          <UniformGrid Columns="3">
            <Button Style="{StaticResource ToolMenuRow}" Tag="obsidian-gold" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#E0B75A"/><TextBlock Text="Obsidian Gold" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Black · warm gold" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="platinum-blue" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#1467D8"/><TextBlock Text="Platinum Blue" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Clean · professional" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="royal-amethyst" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#8D55DE"/><TextBlock Text="Royal Amethyst" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Deep royal purple" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="emerald-executive" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#21B88A"/><TextBlock Text="Emerald Executive" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Premium green" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="champagne-minimal" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#C39B68"/><TextBlock Text="Champagne Minimal" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Warm and refined" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="graphite-copper" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#E28A4D"/><TextBlock Text="Graphite Copper" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Industrial copper" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="sapphire-noir" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#2E86FF"/><TextBlock Text="Sapphire Noir" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Dark electric blue" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="ivory-luxe" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#B6854A"/><TextBlock Text="Ivory Luxe" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Timeless ivory" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="rose-titanium" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#E187B1"/><TextBlock Text="Rose Titanium" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Modern muted rose" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="arctic-glass" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#32B6E8"/><TextBlock Text="Arctic Glass" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Bright frosted blue" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="dracula" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#BD93F9"/><TextBlock Text="Dracula" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Classic dark purple" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Button Style="{StaticResource ToolMenuRow}" Tag="makan-lab" Click="SetTheme_Click" Margin="2"><StackPanel><Border Height="8" CornerRadius="4" Background="#58A6FF"/><TextBlock Text="Makan Lab" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Website signature" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Popup>

    <!-- "More" overflow popup -->
    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=BtnMore}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8" Width="270">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Button Style="{StaticResource ToolMenuRow}" Click="AddBatch_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Add batch download…" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="SiteGrabber_Click" ToolTip="Grab web page links"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE774;" FontSize="16" Foreground="{DynamicResource IconTeal}" Margin="0,0,10,0"/><TextBlock Text="Site grabber" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="Center_Click" ToolTip="Server learning &amp; health checks"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7B8;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Intelligent Center" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button Style="{StaticResource ToolMenuRow}" Click="AppMenu_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Newest first" Tag="Id:Descending" Click="Sort_Click"/>
                <MenuItem Header="Oldest first" Tag="Id:Ascending" Click="Sort_Click"/>
