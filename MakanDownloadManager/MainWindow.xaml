<Window x:Class="MakanDownloadManager.MainWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epsilon Download Manager" Width="1240" Height="740" MinWidth="920" MinHeight="500" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <!-- toolbar button: icon over a small caption, rounded hover -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToolCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="ToolSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Margin" Value="6,6"/>
      <Setter Property="Background" Value="{DynamicResource Border}"/>
    </Style>

    <!-- a row in the toolbar's "More" overflow popup: icon on the left, full-width label, left-aligned -->
    <Style x:Key="ToolMenuRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- list rows: roomy download cards -->
    <Style x:Key="RowStyle" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,8"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- menu bar -->
    <Menu DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="6,3">
      <MenuItem Header="_Tasks">
        <MenuItem Header="Add _new download…" InputGestureText="Ctrl+N" Click="Add_Click"/>
        <MenuItem Header="Add _torrent or magnet link…" Click="AddTorrent_Click"/>
        <MenuItem Header="Add _batch download…" Click="AddBatch_Click"/>
        <MenuItem Header="Add batch download from _clipboard" InputGestureText="Ctrl+V" Click="BatchClipboard_Click"/>
        <MenuItem Header="Run site _grabber…" Click="SiteGrabber_Click"/>
        <Separator/>
        <MenuItem x:Name="ShowDropTarget" Header="Show _drop target" IsCheckable="True" Click="ShowDropTarget_Click"/>
        <Separator/>
        <MenuItem Header="_Export">
          <MenuItem Header="To _text file…" Click="ExportText_Click"/>
        </MenuItem>
        <MenuItem Header="_Import">
          <MenuItem Header="From _text file…" Click="ImportText_Click"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_File">
        <MenuItem Header="_Open" InputGestureText="Enter" Click="Open_Click"/>
        <MenuItem Header="Open _folder" Click="OpenFolder_Click"/>
        <MenuItem Header="_Copy address" Click="CopyUrl_Click"/>
        <Separator/>
        <MenuItem Header="Export _diagnostic report" Click="Diagnostics_Click"/>
      </MenuItem>
      <MenuItem Header="_Downloads">
        <MenuItem Header="_Resume" Click="Start_Click"/>
        <MenuItem Header="_Stop" Click="Pause_Click"/>
        <MenuItem Header="Stop _all" Click="StopAll_Click"/>
        <Separator/>
        <MenuItem Header="_Scheduler…" Click="Scheduler_Click"/>
        <MenuItem Header="Start the _main download queue" Click="StartMainQueue_Click"/>
        <MenuItem Header="Stop all _queues" Click="StopQueues_Click"/>
        <MenuItem Header="Resume all stopped downloads" Click="StartAll_Click"/>
        <Separator/>
        <MenuItem Header="Re_download" Click="Retry_Click"/>
        <MenuItem Header="_Delete" InputGestureText="Del" Click="Remove_Click"/>
        <MenuItem Header="Delete _completed" Click="DeleteCompleted_Click"/>
        <Separator/>
        <MenuItem Header="Raise priority" Click="PriorityUp_Click"/>
        <MenuItem Header="Lower priority" Click="PriorityDown_Click"/>
        <Separator/>
        <MenuItem Header="_Options…" Click="Settings_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ShowCategories" Header="_Categories panel" IsCheckable="True" IsChecked="True" Click="ToggleCategories_Click"/>
        <MenuItem Header="Download _history…" Click="History_Click"/>
        <MenuItem Header="_Sort downloads">
          <MenuItem Header="Newest first" Tag="Id:Descending" Click="Sort_Click"/>
          <MenuItem Header="Oldest first" Tag="Id:Ascending" Click="Sort_Click"/>
          <Separator/>
          <MenuItem Header="Name (A–Z)" Tag="FileName:Ascending" Click="Sort_Click"/>
          <MenuItem Header="Name (Z–A)" Tag="FileName:Descending" Click="Sort_Click"/>
          <MenuItem Header="Size (largest first)" Tag="TotalBytes:Descending" Click="Sort_Click"/>
          <MenuItem Header="Size (smallest first)" Tag="TotalBytes:Ascending" Click="Sort_Click"/>
          <MenuItem Header="Status" Tag="Status:Ascending" Click="Sort_Click"/>
          <MenuItem Header="Progress" Tag="Progress:Descending" Click="Sort_Click"/>
          <MenuItem Header="Speed" Tag="SpeedBytesPerSec:Descending" Click="Sort_Click"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Intelligent _Center" Click="Center_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Getting started" Click="GettingStarted_Click"/>
        <MenuItem Header="_About Epsilon Download Manager" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <!-- product identity header -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentDark}" BorderThickness="0,0,0,1" Padding="18,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentDark}" Margin="0,0,14,0">
            <Border.Effect>
              <DropShadowEffect Color="#39F5B0" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>
            <TextBlock Text="E" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="EPSILON DOWNLOAD MANAGER" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TopBarText}"/>
            <TextBlock Text="Fast, intelligent and private downloading" FontSize="11" Foreground="{DynamicResource TopBarText}" Opacity="0.78" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <!-- live status pills -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource StatusPill}">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="SmartDot" Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Success}" Margin="0,0,7,0" VerticalAlignment="Center">
                <Border.Effect>
                  <DropShadowEffect Color="#39F5B0" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>
              </Border>
              <TextBlock x:Name="SmartText" Text="SMART ENGINE ON" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatusPill}" Margin="0">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="BrowserDot" Width="8" Height="8" CornerRadius="1" Background="{DynamicResource Warning}" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="BrowserText" Text="BROWSER NOT CONNECTED" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- main toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
      <DockPanel>
        <Border DockPanel.Dock="Right" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="10" Padding="10,0" VerticalAlignment="Center" Margin="10,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
            <TextBox x:Name="SearchBox" Width="180" BorderThickness="0" Background="Transparent" Padding="8,7" TextChanged="SearchBox_TextChanged" ToolTip="Search downloads by name or URL"/>
          </StackPanel>
        </Border>
        <WrapPanel Orientation="Horizontal">
          <Button Style="{StaticResource ToolBtn}" Click="Add_Click" ToolTip="Add a download (Ctrl+N)">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" Foreground="{DynamicResource Accent}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Add URL"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolBtn}" Click="AddTorrent_Click" ToolTip="Add a magnet link or a .torrent file">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE753;" Foreground="{DynamicResource Success}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Add Torrent"/></StackPanel>
          </Button>
          <Button x:Name="BtnResume" Style="{StaticResource ToolBtn}" Click="Start_Click" ToolTip="Resume selected downloads">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Resume"/></StackPanel>
          </Button>
          <Button x:Name="BtnStop" Style="{StaticResource ToolBtn}" Click="Pause_Click" ToolTip="Stop selected downloads">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" Foreground="{DynamicResource Warning}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Stop"/></StackPanel>
          </Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnStartAllTop" Style="{StaticResource ToolBtn}" Click="StartAll_Click" ToolTip="Resume all stopped downloads">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;" Foreground="{DynamicResource Success}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Start All"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolBtn}" Click="Scheduler_Click" ToolTip="Open download schedules and queues">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE787;" Foreground="{DynamicResource IconPurple}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Schedule"/></StackPanel>
          </Button>
          <Button x:Name="BtnStopAllTop" Style="{StaticResource ToolBtn}" Click="StopAll_Click" ToolTip="Stop every running download">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" Foreground="{DynamicResource Danger}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Stop All"/></StackPanel>
          </Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnSpeedLimiter" Style="{StaticResource ToolBtn}" Click="SpeedLimiter_Click" ToolTip="Limit total download speed">
            <StackPanel>
              <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE9E9;" Foreground="{DynamicResource IconAmber}"/>
              <TextBlock x:Name="SpeedLimiterCaption" Style="{StaticResource ToolCaption}" Text="Unlimited"/>
            </StackPanel>
          </Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnDelete" Style="{StaticResource ToolBtn}" Click="Remove_Click" ToolTip="Delete selected downloads (Del)">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" Foreground="{DynamicResource Danger}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Delete"/></StackPanel>
          </Button>
          <Border Style="{StaticResource ToolSeparator}"/>
          <Button x:Name="BtnMore" Style="{StaticResource ToolBtn}" Click="More_Click" ToolTip="More options &amp; tools">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE712;" Foreground="{DynamicResource IconGrey}"/><TextBlock Style="{StaticResource ToolCaption}" Text="More"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolBtn}" Click="Settings_Click" ToolTip="Options &amp; Settings">
            <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" Foreground="{DynamicResource IconTeal}"/><TextBlock Style="{StaticResource ToolCaption}" Text="Options"/></StackPanel>
          </Button>
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- Speed Limiter popup -->
    <Popup x:Name="SpeedLimiterPopup" PlacementTarget="{Binding ElementName=BtnSpeedLimiter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" Width="290">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Speed Limiter" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource Text}" Margin="0,0,0,4"/>
          <TextBlock Text="Caps the speed of ordinary downloads. Torrents have their own limits in Options &gt; BitTorrent." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <CheckBox x:Name="SpeedLimiterToggle" Content="Limit enabled" Click="SpeedLimiterToggle_Click" Margin="0,0,0,12"/>

          <TextBlock Text="Apply the entered speed" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
          <StackPanel Margin="0,0,0,12">
            <RadioButton x:Name="SpeedCombined" Content="Across all downloads combined" GroupName="SpeedScope" Click="SpeedScope_Click" Margin="0,2"/>
            <RadioButton x:Name="SpeedPerFile" Content="To each download separately" GroupName="SpeedScope" Click="SpeedScope_Click" Margin="0,5,0,2"/>
          </StackPanel>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Slider x:Name="SpeedLimiterSlider" Grid.Column="0" Minimum="0" Maximum="10240" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="SpeedLimiterSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="SpeedLimiterBox" Width="68" TextAlignment="Right" TextChanged="SpeedLimiterBox_TextChanged"/>
              <TextBlock Text="KB/s" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="Quick presets" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
          <WrapPanel x:Name="SpeedLimiterPresets" Margin="0,0,0,4"/>

          <TextBlock x:Name="SpeedLimiterTorrentNote" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- "More" overflow popup -->
    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=BtnMore}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="8" Width="250">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
          <Button x:Name="BtnStopAll" Style="{StaticResource ToolMenuRow}" Click="StopAll_Click" ToolTip="Stop every running download"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" FontSize="16" Foreground="{DynamicResource Danger}" Margin="0,0,10,0"/><TextBlock Text="Stop All" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Button x:Name="BtnDeleteCompleted" Style="{StaticResource ToolMenuRow}" Click="DeleteCompleted_Click" ToolTip="Remove finished downloads from the list"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE73E;" FontSize="16" Foreground="{DynamicResource Success}" Margin="0,0,10,0"/><TextBlock Text="Delete Completed" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <Button Style="{StaticResource ToolMenuRow}" Click="Center_Click" ToolTip="Server learning &amp; health checks"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7B8;" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><TextBlock Text="Intelligent Center" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <Button Style="{StaticResource ToolMenuRow}" Click="SiteGrabber_Click" ToolTip="Grab web page links"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE774;" FontSize="16" Foreground="{DynamicResource IconTeal}" Margin="0,0,10,0"/><TextBlock Text="Grabber" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel></Button>
          <Border Height="1" Background="{DynamicResource Border}" Margin="6,4"/>
          <TextBlock Text="Theme" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,4,0,2"/>
          <Button x:Name="ThemeLightRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="light"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE708;" FontSize="16" Foreground="{DynamicResource IconGrey}" Margin="0,0,10,0"/><TextBlock Text="Light" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeLightCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeOrangeRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="orange"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#D6690A" Margin="0,0,10,0"/><TextBlock Text="Orange" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeOrangeCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeMakanRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="makan"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#39F5B0" Margin="0,0,10,0"/><TextBlock Text="Makan" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeMakanCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeObsidianRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="obsidian"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#4D7CFF" Margin="0,0,10,0"/><TextBlock Text="Obsidian" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeObsidianCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeNebulaRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="nebula"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#A78BFA" Margin="0,0,10,0"/><TextBlock Text="Nebula" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeNebulaCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeLilacRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="lilac"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#D8A7F2" Margin="0,0,10,0"/><TextBlock Text="Lilac" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeLilacCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeDraculaRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="dracula"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#FF5555" Margin="0,0,10,0"/><TextBlock Text="Dracula" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeDraculaCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="ThemeUhnohhRow" Style="{StaticResource ToolMenuRow}" Click="SetTheme_Click" Tag="uhnohh"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE790;" FontSize="16" Foreground="#FFD84D" Margin="0,0,10,0"/><TextBlock Text="Uhnohh" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel><TextBlock Grid.Column="1" x:Name="ThemeUhnohhCheck" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Button>
        </StackPanel>
      </Border>
    </Popup>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ActiveText" Margin="0,0,20,0" Foreground="{DynamicResource Muted}" Text="0 active" FontFamily="{StaticResource MonoFont}"/>
          <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,1,6,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="TotalSpeed" MinWidth="90" FontWeight="Bold" Foreground="{DynamicResource Accent}" Text="0 B/s" FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="Footer" Foreground="{DynamicResource Muted}" Text="Ready" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- categories + list -->
    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="CategoryColumn" Width="230"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Category Panel -->
      <Border x:Name="CategoryPanel" Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
        <DockPanel Margin="6,10">
          <TextBlock DockPanel.Dock="Top" Text="LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="12,4,12,8"/>
          <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" SelectedItemChanged="Tree_SelectedItemChanged"/>
        </DockPanel>
      </Border>
      
      <GridSplitter x:Name="Splitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>

      <!-- Downloads List -->
      <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
        <Grid>
        <ListView x:Name="Downloads" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Margin="4"
                  ItemContainerStyle="{StaticResource RowStyle}" SelectionChanged="Downloads_SelectionChanged" MouseDoubleClick="Downloads_DoubleClick" ContextMenuOpening="Downloads_ContextMenuOpening"
                  PreviewMouseDown="Downloads_PreviewMouseDown" PreviewMouseLeftButtonDown="Downloads_PreviewMouseLeftButtonDown" PreviewMouseMove="Downloads_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="Downloads_PreviewMouseLeftButtonUp" LostMouseCapture="Downloads_LostMouseCapture">
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="Open_Click"/>
              <MenuItem x:Name="PlayPartialMenuItem" Header="Play (downloaded part)" Click="PlayPartial_Click" Tag="play"/>
              <MenuItem x:Name="ForceDownloadMenuItem" Header="Force Download" IsCheckable="True" Click="ForceDownload_Click" ToolTip="Ignore schedule for this torrent" Tag="force"/>
              <MenuItem Header="Open folder" Click="OpenFolder_Click"/>
              <Separator/>
              <MenuItem Header="Resume" Click="Start_Click"/>
              <MenuItem Header="Stop" Click="Pause_Click"/>
              <MenuItem Header="Redownload" Click="Retry_Click"/>
              <Separator/>
              <MenuItem Header="Raise priority" Click="PriorityUp_Click"/>
              <MenuItem Header="Lower priority" Click="PriorityDown_Click"/>
              <MenuItem Header="Copy address" Click="CopyUrl_Click"/>
              <MenuItem Header="Add to queue" Tag="queue"/>
              <Separator/>
              <MenuItem Header="Delete" Click="Remove_Click"/>
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="DOWNLOAD" Width="340">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,3">
                      <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="QUEUE" Width="95">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Border Visibility="{Binding QueueMark, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}" CornerRadius="3" Padding="8,2" Background="{DynamicResource Surface}">
                      <TextBlock Text="{Binding QueueMark}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource IconPurple}"/>
                    </Border>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="SIZE" Width="110">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding SizeDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="STATUS &amp; PROGRESS" Width="170">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Width="150" VerticalAlignment="Center">
                      <DockPanel>
                        <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:0}%'}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}"/>
                      </DockPanel>
                      <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,4,0,0" Visibility="Collapsed"
                                   Foreground="{StaticResource BrandGrad}" Background="{DynamicResource Track}" BorderThickness="0"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter TargetName="Bar" Property="Visibility" Value="Visible"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource AccentDark}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Queued"><Setter TargetName="Bar" Property="Visibility" Value="Visible"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource IconPurple}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Complete"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="ETA" Width="85">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding TimeLeft}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="SPEED" Width="110">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Rate}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="UP SPEED" Width="95">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding UpSpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="PEERS" Width="100">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding PeersText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource IconTeal}" VerticalAlignment="Center"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="LAST TRY" Width="130">
                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LastTry}" Foreground="{DynamicResource Text}"/></DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="DESCRIPTION" Width="300">
                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
          <Canvas x:Name="SelectionCanvas" Margin="4" IsHitTestVisible="False" Panel.ZIndex="10">
            <Border x:Name="SelectionRectangle" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="1" Opacity="0.62"/>
          </Canvas>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>

