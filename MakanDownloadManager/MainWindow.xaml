      <Grid Margin="14,10,14,9">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2.3*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,7,0"><DockPanel><Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="#262F7DF0" BorderBrush="#2F7DF0" BorderThickness="0.8" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#2F7DF0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="34"/></Grid.RowDefinitions><TextBlock Text="Download Speed" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderDownloadSpeed" Grid.Row="1" Text="0 B/s" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}"/><Grid Grid.Row="2" x:Name="DownSparkHost" ClipToBounds="True" Margin="0,2,0,0"><Polygon x:Name="DownSparkArea" Fill="{DynamicResource Accent}" Opacity="0.16" HorizontalAlignment="Left" VerticalAlignment="Top"/><Polyline x:Name="DownSparkLine" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid></Grid></DockPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,7,0"><DockPanel><Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="#265B7CFA" BorderBrush="#4F6BED" BorderThickness="0.8" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#4F6BED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="34"/></Grid.RowDefinitions><TextBlock Text="Upload Speed" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderUploadSpeed" Grid.Row="1" Text="0 B/s" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}"/><Grid Grid.Row="2" x:Name="UpSparkHost" ClipToBounds="True" Margin="0,2,0,0"><Polygon x:Name="UpSparkArea" Fill="{DynamicResource IconPurple}" Opacity="0.16" HorizontalAlignment="Left" VerticalAlignment="Top"/><Polyline x:Name="UpSparkLine" Stroke="{DynamicResource IconPurple}" StrokeThickness="1.6" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid></Grid></DockPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,7,0"><DockPanel><Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="#262F7DF0" BorderBrush="#2F7DF0" BorderThickness="0.8" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#2F7DF0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="12"/></Grid.RowDefinitions><TextBlock Text="Active Downloads" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderActiveCount" Grid.Row="1" Text="0 / 0" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold"/><ProgressBar x:Name="ActiveBar" Grid.Row="2" Height="8" Margin="0,4,0,0" Maximum="100" Value="0"/></Grid></DockPanel></Border>
        <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,7,0"><DockPanel><Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="#26F0A030" BorderBrush="#F08A1E" BorderThickness="0.8" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#F08A1E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="12"/></Grid.RowDefinitions><TextBlock Text="Queue" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HeaderQueueCount" Grid.Row="1" Text="0 waiting" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold"/><ProgressBar x:Name="QueueBar" Grid.Row="2" Height="8" Margin="0,4,0,0" Maximum="100" Value="0" Foreground="{DynamicResource Warning}"/></Grid></DockPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="6,4"><Grid><TextBlock x:Name="HeaderMultiNet" Visibility="Collapsed"/><UniformGrid Columns="3" VerticalAlignment="Center"><Button Click="StopAll_Click" Margin="3" Padding="6,7" Background="#1AE5484D" BorderBrush="#55E5484D" BorderThickness="1" ToolTip="Stop every running download"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#E5484D" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Stop All" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button><Button Click="StopAll_Click" Margin="3" Padding="6,7" Background="#1A2F7DF0" BorderBrush="#552F7DF0" BorderThickness="1" ToolTip="Pause every running download"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#2F7DF0" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Pause All" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button><Button Click="StartAll_Click" Margin="3" Padding="6,7" Background="#1A22A878" BorderBrush="#5522A878" BorderThickness="1" ToolTip="Resume all downloads"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#22A878" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Resume All" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Click="Clipboard_Click" Padding="6,7" ToolTip="Paste Link"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Paste Link" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="1" Click="OpenButtonMenu_Click" Padding="7,7" Margin="1,0,0,0" ToolTip="More" Content="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"><Button.ContextMenu><ContextMenu><MenuItem Header="Add URL…" Click="Add_Click"/><MenuItem Header="Add batch from clipboard" Click="BatchClipboard_Click"/><MenuItem Header="Add torrent or magnet" Click="AddTorrent_Click"/></ContextMenu></Button.ContextMenu></Button></Grid><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Click="StartMainQueue_Click" Padding="6,7" ToolTip="Start Queue"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Start Queue" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button><Button Grid.Column="1" Click="OpenButtonMenu_Click" Padding="7,7" Margin="1,0,0,0" ToolTip="More" Content="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"><Button.ContextMenu><ContextMenu><MenuItem Header="Start main queue" Click="StartMainQueue_Click"/><MenuItem Header="Choose a queue to start…" Click="StartQueue_Click"/><MenuItem Header="Stop all queues" Click="StopQueues_Click"/></ContextMenu></Button.ContextMenu></Button></Grid><Button Click="DeleteCompleted_Click" Margin="2" Padding="6,3" ToolTip="Remove all finished downloads from the list (files stay on disk)"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#B55C8E" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Delete done" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button></UniformGrid></Grid></Border>
