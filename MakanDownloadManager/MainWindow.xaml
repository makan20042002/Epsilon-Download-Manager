    <!-- v6 delete prompt: the file is never erased unless the user explicitly chooses a disk action. -->
    <Popup x:Name="DeleteActionPopup" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="20" Width="540">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.42" Color="Black"/></Border.Effect>
        <StackPanel>
          <DockPanel Margin="0,0,0,14"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource Danger}" Margin="0,0,12,0"/><StackPanel><TextBlock x:Name="DeleteBarTitle" Text="Delete selected download?" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock x:Name="DeleteBarHelp" Text="Choose exactly what Epsilon should remove." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DeleteTorrentNote" Text="Removing a seeding torrent also stops sharing it." FontSize="11" Foreground="{DynamicResource Warning}" Margin="0,5,0,0" Visibility="Collapsed"/></StackPanel></DockPanel>
          <Button Click="DeleteBarRemove_Click" Style="{StaticResource ToolMenuRow}" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Muted}"/><StackPanel Grid.Column="1"><TextBlock Text="Remove from list" FontWeight="SemiBold"/><TextBlock Text="Keep every downloaded file on your disk." FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="R" Foreground="{DynamicResource Muted}"/></Grid></Button>
          <Button x:Name="DeleteFileOnlyButton" Click="DeleteBarFileOnly_Click" Style="{StaticResource ToolMenuRow}" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Warning}"/><StackPanel Grid.Column="1"><TextBlock Text="Delete file only" FontWeight="SemiBold"/><TextBlock Text="Erase its data but keep the entry so it can be downloaded again." FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="F" Foreground="{DynamicResource Muted}"/></Grid></Button>
          <Button x:Name="DeleteUnfinishedDataButton" Click="DeleteBarDisk_Click" Style="{StaticResource ToolMenuRow}" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Danger}"/><StackPanel Grid.Column="1"><TextBlock Text="Delete completely" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/><TextBlock Text="Remove the entry and erase its file from disk. This cannot be undone." FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="D" Foreground="{DynamicResource Muted}"/></Grid></Button>
          <DockPanel Margin="4,14,4,0"><CheckBox x:Name="RememberDeleteChoice" Content="Remember my choice" FontSize="11" Foreground="{DynamicResource Muted}"/><Button DockPanel.Dock="Right" Content="Cancel" Click="DeleteBarCancel_Click" Padding="12,6"/></DockPanel>
        </StackPanel>
      </Border>
    </Popup>

    <!-- categories + list: must stay the LAST child of the DockPanel so it fills the window -->
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="CategoryColumn" Width="0"/>
        <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Category Panel -->
      <Border x:Name="CategoryPanel" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4">
        <DockPanel Margin="6,10">
          <TextBlock DockPanel.Dock="Top" Text="LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="12,4,12,8"/>
          <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" SelectedItemChanged="Tree_SelectedItemChanged"/>
        </DockPanel>
      </Border>
      
      <GridSplitter x:Name="Splitter" Grid.Column="1" Visibility="Collapsed" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>

      <!-- Downloads List -->
      <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0" CornerRadius="0">
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,7">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox Content="Select all" Click="SelectAll_Click" VerticalAlignment="Center" Margin="3,0,18,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Sort:" FontSize="10.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <Button Style="{StaticResource ToolMenuRow}" Padding="7,3" Tag="FileName" Content="Name" Click="SortButton_Click"/>
              <Button Style="{StaticResource ToolMenuRow}" Padding="7,3" Tag="TotalBytes" Content="Size" Click="SortButton_Click"/>
              <Button Style="{StaticResource ToolMenuRow}" Padding="7,3" Tag="Status" Content="Status" Click="SortButton_Click"/>
              <Button Style="{StaticResource ToolMenuRow}" Padding="7,3" Tag="SpeedBytesPerSec" Content="Speed" Click="SortButton_Click"/>
              <Button Style="{StaticResource ToolMenuRow}" Padding="7,3" Tag="Id" Content="Date added ↓" Click="SortButton_Click"/>
            </StackPanel>
            <StackPanel x:Name="SelectionActions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
              <TextBlock x:Name="SelectedCountText" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button Content="Resume" Click="Start_Click" Padding="8,3" Margin="2,0"/>
              <Button Content="Stop" Click="Pause_Click" Padding="8,3" Margin="2,0"/>
              <Button Content="Move to queue ▾" Click="MoveSelectedQueue_Click" Padding="8,3" Margin="2,0"/>
              <Button Content="Delete…" Click="Remove_Click" Padding="8,3" Margin="2,0" Foreground="{DynamicResource Danger}"/>
            </StackPanel>
          </Grid>
        </Border>
        <ListView Grid.Row="1" x:Name="Downloads" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Margin="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                  ItemContainerStyle="{StaticResource RowStyle}" SelectionChanged="Downloads_SelectionChanged" MouseDoubleClick="Downloads_DoubleClick" ContextMenuOpening="Downloads_ContextMenuOpening"
                  PreviewMouseDown="Downloads_PreviewMouseDown" PreviewMouseLeftButtonDown="Downloads_PreviewMouseLeftButtonDown" PreviewMouseMove="Downloads_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="Downloads_PreviewMouseLeftButtonUp" LostMouseCapture="Downloads_LostMouseCapture">
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="Open_Click"/>
              <MenuItem x:Name="PlayPartialMenuItem" Header="Play (downloaded part)" Click="PlayPartial_Click" Tag="play"/>
              <MenuItem x:Name="ForceDownloadMenuItem" Header="Force Download" IsCheckable="True" Click="ForceDownload_Click" ToolTip="Ignore schedule for this torrent" Tag="force"/>
              <MenuItem Header="Open folder" Click="OpenFolder_Click"/>
              <Separator/>
              <MenuItem Header="Resume" Click="Start_Click"/>
              <MenuItem Header="Stop" Click="Pause_Click"/>
              <MenuItem Header="Redownload" Click="Retry_Click"/>
              <Separator/>
              <MenuItem Header="Raise priority" Click="PriorityUp_Click"/>
              <MenuItem Header="Lower priority" Click="PriorityDown_Click"/>
              <MenuItem Header="Copy address" Click="CopyUrl_Click"/>
              <MenuItem Header="Add to queue" Tag="queue"/>
              <Separator/>
              <MenuItem Header="Delete" Click="Remove_Click"/>
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" MinWidth="104"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border x:Name="TypeBox" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="7,1,7,2" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock x:Name="TypeText" Text="{Binding TypeBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FilePath}"/>
                <Border Grid.Column="3" Visibility="{Binding QueueMark, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,1,8,2" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="{Binding QueueMark}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource Surface}" CornerRadius="11" Padding="9,2,10,3" VerticalAlignment="Center" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,1,6,0"/><TextBlock x:Name="StatusLabel" Text="{Binding RowStatusText}" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel>
                </Border>
                <TextBlock x:Name="SpeedLabel" Grid.Column="5" Text="{Binding Rate}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Grid.Column="6" Content="•••" Click="RowMore_Click" ToolTip="More actions" Style="{StaticResource ToolMenuRow}" Padding="8,2" Margin="8,0,0,0" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <local:SegmentBar x:Name="Map" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Height="7" Margin="0,9,0,0" Item="{Binding}" Progress="{Binding Progress, Mode=OneWay}" Status="{Binding Status, Mode=OneWay}"
                                  Fill="{DynamicResource Accent}" Track="{DynamicResource Track}" DoneFill="{DynamicResource Success}" TorrentFill="{DynamicResource IconPurple}"/>
                <DockPanel x:Name="Meta" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="6" Margin="0,7,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Progress, StringFormat='{}{0:0}%'}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Text}" Margin="12,0,0,0"/>
                  <TextBlock Text="{Binding SizeText}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,16,0"/>
                  <TextBlock x:Name="ConnText" Visibility="Collapsed" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,16,0"><Run Text="{Binding ActiveConnections, Mode=OneWay}"/><Run Text=" connections"/></TextBlock>
                  <TextBlock Text="{Binding PeersText}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" Visibility="{Binding PeersText, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>
                  <TextBlock Text="{Binding UpSpeedText}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" Visibility="{Binding UpSpeedText, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>
                  <TextBlock Text="{Binding TimeLeft}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" Visibility="{Binding TimeLeft, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>
                  <TextBlock Text="{Binding CompletionDetails}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" Visibility="{Binding CompletionDetails, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>
                  <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="520" Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </DockPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding TypeKind}" Value="torrent"><Setter TargetName="TypeBox" Property="BorderBrush" Value="{DynamicResource IconPurple}"/><Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource IconPurple}"/></DataTrigger>
                <DataTrigger Binding="{Binding TypeKind}" Value="video"><Setter TargetName="TypeBox" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Accent}"/><Setter TargetName="ConnText" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Queued"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource IconPurple}"/><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource IconPurple}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Complete"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Success}"/><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Success}"/><Setter TargetName="SpeedLabel" Property="Text" Value="{Binding SizeDisplay}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Danger}"/><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Warning}"/><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListView}}" Value="compact"><Setter TargetName="Map" Property="Visibility" Value="Collapsed"/><Setter TargetName="Meta" Property="Visibility" Value="Collapsed"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
          <Canvas Grid.Row="1" x:Name="SelectionCanvas" Margin="0" IsHitTestVisible="False" Panel.ZIndex="10">
            <Border x:Name="SelectionRectangle" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="1" Opacity="0.62"/>
          </Canvas>
        </Grid>
      </Border>
    </Grid>

  </DockPanel>
</Window>
