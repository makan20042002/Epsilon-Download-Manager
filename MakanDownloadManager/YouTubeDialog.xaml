<Window x:Class="MakanDownloadManager.YouTubeDialog" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download video" Width="720" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel>
    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="22,18"><StackPanel><TextBlock Text="Video download" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Choose the quality, destination and schedule queue." Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource CardBorder}" Margin="22,18,22,12" Padding="18"><StackPanel>
    <TextBlock x:Name="AddressText" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock x:Name="InfoText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,12,0,0" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}"/>

    <Border x:Name="SetupPanel" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock x:Name="SetupText" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="OptionsButton" Content="Open Options" Click="OpenOptions_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
          <Button Content="Try again" Click="Retry_Click" Margin="0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <ListView x:Name="OptionList" Height="240" Margin="0,12,0,0" Visibility="Collapsed" SelectionChanged="Option_Changed" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Choice" Width="250" DisplayMemberBinding="{Binding Label}"/>
          <GridViewColumn Header="Type" Width="200" DisplayMemberBinding="{Binding Kind}"/>
          <GridViewColumn Header="Size" Width="150" DisplayMemberBinding="{Binding Size}"/>
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock Text="Save to" Margin="0,14,0,4"/>
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/>
      <TextBox x:Name="FolderBox"/>
    </DockPanel>
    <TextBlock x:Name="FileNameText" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

    <TextBlock Text="Download queue" Margin="0,12,0,4"/>
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="New queue…" Click="NewQueue_Click" Margin="8,0,0,0"/>
      <ComboBox x:Name="QueueBox" DisplayMemberPath="Name"/>
    </DockPanel>

    </StackPanel></Border>
    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="22,14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="StartButton" Content="Start Download" Click="Start_Click" IsDefault="True" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="LaterButton" Content="Download Later" Click="Later_Click" IsEnabled="False"/>
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel></Border>
  </StackPanel>
</Window>
