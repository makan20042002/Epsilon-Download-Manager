<Window Style="{StaticResource AppWindow}" x:Class="MakanDownloadManager.DownloadInfoDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download File Info" Width="760" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="22,18">
      <DockPanel><Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource Selected}" Margin="0,0,14,0"><TextBlock Text="↓" FontSize="23" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Add download" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Review the source, destination and integrity check before starting." Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel></DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="22,18,22,12" Padding="18">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Address" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
    <TextBox x:Name="UrlBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" Padding="7" Margin="0,0,0,10"/>

    <TextBlock x:Name="NameLabel" Grid.Row="1" Text="Save as" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
    <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="7" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="2" Text="Save to folder" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
    <TextBox x:Name="FolderBox" Grid.Row="2" Grid.Column="1" Padding="7" Margin="0,0,0,10"/>
    <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Click="Browse_Click" Margin="6,0,0,10"/>

    <TextBlock x:Name="QueueLabel" Grid.Row="3" Text="Download queue" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
    <ComboBox x:Name="QueueBox" Grid.Row="3" Grid.Column="1" Padding="6" Margin="0,0,0,10" DisplayMemberPath="Name"
              ToolTip="Choose the queue that will contain this download."/>
    <Button Grid.Row="3" Grid.Column="2" Content="New queue…" Click="NewQueue_Click" Margin="6,0,0,10"/>

    <TextBlock x:Name="HashLabel" Grid.Row="4" Text="Expected SHA-256" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
    <TextBox x:Name="HashBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Padding="7" Margin="0,0,0,10"
             ToolTip="Optional: paste the 64-character SHA-256 published by the download provider."/>

      <TextBlock x:Name="InfoText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
    </Grid>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="22,14">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="StartButton" Content="Start Download" IsDefault="True" Click="Start_Click" Background="{DynamicResource AccentDark}" Foreground="{DynamicResource OnAccent}" MinWidth="120"/>
      <Button x:Name="LaterButton" Content="Download Later" Click="Later_Click" MinWidth="120"/>
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="80"/>
    </StackPanel>
    </Border>
  </Grid>
</Window>
