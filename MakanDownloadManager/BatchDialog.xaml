<Window x:Class="MakanDownloadManager.BatchDialog" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Batch Download" Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="22">
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Type an address with a * where the numbers or letters change, for example  https://site.example/photos/img*.jpg"/>
    <TextBox x:Name="PatternBox" TextChanged="Changed" Margin="0,0,0,14"/>

    <GroupBox Header="Replace the * with" Padding="12,8">
      <StackPanel>
        <RadioButton x:Name="NumbersRadio" GroupName="Kind" Content="Numbers" IsChecked="True" Checked="Changed" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="22,0,0,10">
          <TextBlock Text="from" VerticalAlignment="Center"/><TextBox x:Name="FromBox" Width="70" Text="1" Margin="8,0,14,0" TextChanged="Changed"/>
          <TextBlock Text="to" VerticalAlignment="Center"/><TextBox x:Name="ToBox" Width="70" Text="10" Margin="8,0,14,0" TextChanged="Changed"/>
          <TextBlock Text="step" VerticalAlignment="Center"/><TextBox x:Name="StepBox" Width="50" Text="1" Margin="8,0,14,0" TextChanged="Changed"/>
          <CheckBox x:Name="ZeroFill" Content="Fill with zeros (001, 002…)" Checked="Changed" Unchecked="Changed" VerticalAlignment="Center"/>
        </StackPanel>
        <RadioButton x:Name="LettersRadio" GroupName="Kind" Content="Letters" Checked="Changed" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
          <TextBlock Text="from" VerticalAlignment="Center"/><TextBox x:Name="LetterFromBox" Width="50" Text="a" MaxLength="1" Margin="8,0,14,0" TextChanged="Changed"/>
          <TextBlock Text="to" VerticalAlignment="Center"/><TextBox x:Name="LetterToBox" Width="50" Text="z" MaxLength="1" Margin="8,0,0,0" TextChanged="Changed"/>
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <TextBlock x:Name="PreviewText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="OK" IsDefault="True" Click="Ok_Click" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="90"/>
    </StackPanel>
  </StackPanel>
</Window>
