<Window x:Class="MakanDownloadManager.ReportBugWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a bug" Width="650" SizeToContent="Height" MaxHeight="790" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22">
      <DockPanel Margin="0,0,0,16">
        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="9" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Margin="0,0,14,0">
          <TextBlock Text="&#xE8F9;" FontFamily="{StaticResource IconFont}" FontSize="23" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel><TextBlock Text="Report a bug or problem" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Tell us what happened so we can improve Epsilon." Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>

      <Border Style="{StaticResource CardBorder}" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Problem type" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
          <ComboBox x:Name="CategoryBox" Grid.Row="1" SelectedIndex="0" Margin="0,5,0,12" Padding="7">
            <ComboBoxItem Content="Download problem"/><ComboBoxItem Content="Browser extension"/><ComboBoxItem Content="Torrent"/><ComboBoxItem Content="Speed or network"/><ComboBoxItem Content="Design or translation"/><ComboBoxItem Content="Other"/>
          </ComboBox>
          <TextBlock Grid.Row="2" Text="Short title" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
          <TextBox x:Name="SubjectBox" Grid.Row="3" Margin="0,5,0,12" Padding="8" MaxLength="120"/>
          <TextBlock Grid.Row="4" Text="What happened?" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
          <TextBox x:Name="DescriptionBox" Grid.Row="5" Margin="0,5,0,12" Padding="8" Height="108" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Grid.Row="6" Text="Steps to reproduce (optional)" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
          <TextBox x:Name="StepsBox" Grid.Row="7" Margin="0,5,0,0" Padding="8" Height="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,14,0,0">
        <StackPanel>
          <CheckBox x:Name="DiagnosticsCheck" Content="Create a diagnostic report to attach" IsChecked="True"/>
          <TextBlock Text="The report contains app and Windows details plus recent Epsilon logs. Passwords, cookies and access tokens are removed. You choose whether to attach it; Epsilon never sends it automatically." Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="24,7,0,0"/>
          <TextBlock x:Name="RecipientText" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusText" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="2,13,2,0"/>
      <DockPanel Margin="0,12,0,0">
        <Button Content="Cancel" IsCancel="True" MinWidth="90"/>
        <Button DockPanel.Dock="Right" Content="Prepare email" Style="{StaticResource PrimaryButton}" Click="Prepare_Click" MinWidth="132"/>
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
